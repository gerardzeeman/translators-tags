# Backup-configuratie — kopieer naar .env.backup en vul in
# Nooit committen (.gitignore bevat .env.backup)

# DigitalOcean Spaces (offsite opslag)
SPACES_BUCKET=jouw-bucket-naam
SPACES_REGION=ams3
SPACES_KEY=DO00XXXXXXXXXXXX
SPACES_SECRET=your_spaces_secret_here
SPACES_PATH=bible-backups          # map binnen de bucket
SPACES_RETENTION_DAYS=30           # bestanden ouder dan dit worden verwijderd

# Lokale backup-locatie (Docker volume pad op de host)
BACKUP_DIR=/var/lib/docker/volumes/translatorstags_backup_data/_data/daily

# Backup-schema (cron-formaat of @daily/@hourly)
BACKUP_SCHEDULE=@daily
BACKUP_KEEP_DAYS=7
BACKUP_KEEP_WEEKS=4
BACKUP_KEEP_MONTHS=6
