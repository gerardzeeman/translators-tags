{
    "name": "bible-compare/app",
    "description": "Bible source language comparison tool",
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.3",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "ext-pdo": "*",
        "ext-pdo_pgsql": "*",
        "doctrine/doctrine-bundle": "^2.11",
        "doctrine/doctrine-migrations-bundle": "^3.3",
        "doctrine/orm": "^3.1",
        "runtime/frankenphp-symfony": "^0.2",
        "symfony/asset": "^7.2",
        "symfony/asset-mapper": "^7.2",
        "symfony/console": "^7.2",
        "symfony/doctrine-messenger": "^7.2",
        "symfony/dotenv": "^7.2",
        "symfony/flex": "^2",
        "symfony/form": "^7.2",
        "symfony/framework-bundle": "^7.2",
        "symfony/http-client": "^7.2",
        "symfony/rate-limiter": "^7.2",
        "symfony/security-bundle": "^7.2",
        "symfony/stimulus-bundle": "^2.18",
        "symfony/twig-bundle": "^7.2",
        "symfony/ux-turbo": "^2.18",
        "symfony/validator": "^7.2",
        "symfony/yaml": "^7.2",
        "symfonycasts/reset-password-bundle": "^1.25",
        "twig/extra-bundle": "^2|^3",
        "twig/twig": "^2.12|^3.0"
    },
    "require-dev": {
        "doctrine/doctrine-fixtures-bundle": "^3.5",
        "phpunit/phpunit": "^11.4",
        "symfony/browser-kit": "^7.2",
        "symfony/css-selector": "^7.2",
        "symfony/debug-bundle": "^7.2",
        "symfony/maker-bundle": "^1.0",
        "symfony/phpunit-bridge": "^7.2",
        "symfony/stopwatch": "^7.2",
        "symfony/web-profiler-bundle": "^7.2"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "sort-packages": true,
        "audit": {
            "ignore": [
                "PKSA-365x-2zjk-pt47",
                "PKSA-b35n-565h-rs4q"
            ]
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "importmap:install": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "^7.2"
        }
    }
}
