{% extends 'base.html.twig' %}

{% block title %}Nieuwsoverzicht-historie – Bijbel Vergelijking{% endblock %}

{% block body %}
<div class="container container--wide">

    <div class="admin-page-header">
        <h1>Nieuwsoverzicht-historie</h1>
    </div>

    {% for label, messages in app.flashes %}
        {% for message in messages %}
        <div class="alert alert-{{ label }}" role="alert">{{ message }}</div>
        {% endfor %}
    {% endfor %}

    <table class="admin-table">
        <thead>
            <tr>
                <th>Verstuurd</th>
                <th>Titel</th>
                <th>Link</th>
                <th>Geslaagd</th>
                <th>Mislukt</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        {% for digest in digests %}
            <tr>
                <td>{{ digest.sentAt|date('d-m-Y H:i', 'Europe/Amsterdam') }}</td>
                {# title/body/url komen van een systeem buiten deze applicatie
                   (de scheduled task) en worden dus als niet-vertrouwde tekst
                   behandeld -- Twig's standaard auto-escaping, nooit |raw
                   (plan §5.3). #}
                <td>{{ digest.title }}</td>
                <td>{{ digest.url ?: '–' }}</td>
                <td>{{ digest.successCount }}</td>
                <td>{{ digest.failureCount }}</td>
                <td>
                    <form method="post" action="{{ path('admin_news_digest_resend', {id: digest.id}) }}" class="form-inline" onsubmit="return confirm('&quot;{{ digest.title|e('js') }}&quot; opnieuw versturen naar alle abonnees?')">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('news_digest_resend_' ~ digest.id) }}">
                        <button type="submit" class="btn-inline">Opnieuw versturen</button>
                    </form>
                </td>
            </tr>
        {% else %}
            <tr class="empty-row"><td colspan="6">Nog geen overzichten verstuurd.</td></tr>
        {% endfor %}
        </tbody>
    </table>

</div>
{% endblock %}
