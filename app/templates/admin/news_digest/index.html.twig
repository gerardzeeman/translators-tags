{% extends 'base.html.twig' %}

{% block title %}Nieuwsoverzicht-historie – Bijbel Vergelijking{% endblock %}

{% block body %}
<div class="container container--wide" data-controller="list-search">

    <div class="admin-page-header">
        <h1>Nieuwsoverzicht-historie</h1>
    </div>

    {% for label, messages in app.flashes %}
        {% for message in messages %}
        <div class="alert alert-{{ label }}" role="alert">{{ message }}</div>
        {% endfor %}
    {% endfor %}

    {% if digests is not empty %}
    <input type="search"
           class="list-search-input"
           placeholder="Zoek op titel…"
           aria-label="Zoek op titel"
           data-list-search-target="input"
           data-action="input->list-search#filter">
    {% endif %}

    <div class="table-scroll admin-news-digest-table-wrap">
    <table class="admin-table">
        <thead>
            <tr>
                <th>Verstuurd</th>
                <th>Titel</th>
                <th>Link</th>
                <th>Geslaagd</th>
                <th>Mislukt</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        {% for digest in digests %}
            <tr data-list-search-target="row" data-search="{{ digest.title|lower }}">
                <td>{{ digest.sentAt|date('d-m-Y H:i', 'Europe/Amsterdam') }}</td>
                {# title/body/url komen van een systeem buiten deze applicatie
                   (de scheduled task) en worden dus als niet-vertrouwde tekst
                   behandeld -- Twig's standaard auto-escaping, nooit |raw
                   (plan §5.3). #}
                <td>{{ digest.title }}</td>
                <td>{{ digest.url ?: '–' }}</td>
                <td>{{ digest.successCount }}</td>
                <td>{{ digest.failureCount }}</td>
                <td>
                    <form method="post" action="{{ path('admin_news_digest_resend', {id: digest.id}) }}" class="form-inline"
                          data-controller="confirm-submit"
                          data-confirm-submit-message-value="&quot;{{ digest.title }}&quot; opnieuw versturen naar alle abonnees?"
                          data-confirm-submit-confirm-label-value="Opnieuw versturen"
                          data-action="submit->confirm-submit#submit">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('news_digest_resend_' ~ digest.id) }}">
                        <button type="submit" class="btn-inline">Opnieuw versturen</button>
                    </form>
                </td>
            </tr>
        {% else %}
            <tr class="empty-row"><td colspan="6">Nog geen overzichten verstuurd.</td></tr>
        {% endfor %}
        </tbody>
    </table>
    </div>

    {# Mobiel: dezelfde data als kaarten i.p.v. een scrollende tabel -- zie
       .admin-news-digest-table-wrap / .admin-news-digest-cards in app.css
       voor de media query die tussen de twee schakelt. #}
    {% if digests is not empty %}
    <div class="admin-news-digest-cards">
        {% for digest in digests %}
        <div class="admin-news-digest-card" data-list-search-target="card" data-search="{{ digest.title|lower }}">
            <div class="admin-news-digest-card-title">{{ digest.title }}</div>

            <dl class="admin-news-digest-card-meta">
                <div><dt>Verstuurd</dt><dd>{{ digest.sentAt|date('d-m-Y H:i', 'Europe/Amsterdam') }}</dd></div>
                <div class="admin-news-digest-card-link-row"><dt>Link</dt><dd>{{ digest.url ?: '–' }}</dd></div>
                <div><dt>Geslaagd</dt><dd>{{ digest.successCount }}</dd></div>
                <div><dt>Mislukt</dt><dd>{{ digest.failureCount }}</dd></div>
            </dl>

            <div class="admin-news-digest-card-actions">
                <form method="post" action="{{ path('admin_news_digest_resend', {id: digest.id}) }}" class="form-inline"
                      data-controller="confirm-submit"
                      data-confirm-submit-message-value="&quot;{{ digest.title }}&quot; opnieuw versturen naar alle abonnees?"
                      data-confirm-submit-confirm-label-value="Opnieuw versturen"
                      data-action="submit->confirm-submit#submit">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('news_digest_resend_' ~ digest.id) }}">
                    <button type="submit" class="btn btn-sm">Opnieuw versturen</button>
                </form>
            </div>
        </div>
        {% endfor %}
    </div>
    {% endif %}

    {# Buiten zowel de tabel (desktop) als de kaarten (mobiel) -- die
       wisselen elkaar af via display:none op basis van viewportbreedte, dus
       een melding bínnen een van de twee zou op het andere formaat
       onzichtbaar blijven. #}
    {% if digests is not empty %}
    <p class="text-muted list-search-empty" data-list-search-target="empty" hidden>Geen overzichten gevonden voor deze zoekopdracht.</p>
    {% endif %}

</div>
{% endblock %}
