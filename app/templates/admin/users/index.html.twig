{% extends 'base.html.twig' %}

{% block title %}Gebruikersbeheer – Bijbel Vergelijking{% endblock %}

{% block body %}
<div class="container container--wide" data-controller="list-search">

    <div class="admin-page-header">
        <h1>Gebruikersbeheer</h1>
        <a href="{{ path('admin_users_new') }}" class="btn btn-primary">+ Nieuwe gebruiker</a>
    </div>

    {% for label, messages in app.flashes %}
        {% for message in messages %}
        <div class="alert alert-{{ label }}" role="alert">{{ message }}</div>
        {% endfor %}
    {% endfor %}

    {% if users is not empty %}
    <input type="search"
           class="list-search-input"
           placeholder="Zoek op naam of e-mailadres…"
           aria-label="Zoek op naam of e-mailadres"
           data-list-search-target="input"
           data-action="input->list-search#filter">
    {% endif %}

    <div class="table-scroll admin-users-table-wrap">
    <table class="admin-table">
        <thead>
            <tr>
                <th>Naam</th>
                <th>E-mail</th>
                <th>Rollen</th>
                <th>Aangemaakt</th>
                <th>Laatste login</th>
                <th>Apparaten (meldingen)</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        {% for user in users %}
            <tr data-list-search-target="row" data-search="{{ (user.displayName ~ ' ' ~ user.email)|lower }}">
                <td>{{ user.displayName }}</td>
                <td>{{ user.email }}</td>
                <td>
                    {% for role in user.roles %}
                        {% if role != 'ROLE_USER' %}
                        <span class="role-badge">{{ role|replace({'ROLE_': ''}) }}</span>
                        {% endif %}
                    {% endfor %}
                </td>
                <td>{{ user.createdAt|date('d-m-Y') }}</td>
                <td>{{ user.lastLoginAt ? user.lastLoginAt|date('d-m-Y H:i') : '–' }}</td>
                <td>{{ push_device_counts[user.id] ?? 0 }}</td>
                <td>
                    <a href="{{ path('admin_users_edit', {id: user.id}) }}">Bewerken</a>
                    {% if user != app.user %}
                    <form method="post" action="{{ path('admin_users_delete', {id: user.id}) }}" class="form-inline"
                          data-controller="confirm-submit"
                          data-confirm-submit-message-value="Gebruiker {{ user.email }} verwijderen?"
                          data-action="submit->confirm-submit#submit">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_user_delete_' ~ user.id) }}">
                        <button type="submit" class="btn-danger-inline">Verwijderen</button>
                    </form>
                    {% endif %}
                </td>
            </tr>
        {% else %}
            <tr class="empty-row"><td colspan="7">Geen gebruikers gevonden.</td></tr>
        {% endfor %}
        </tbody>
    </table>
    </div>

    {# Mobiel: dezelfde data als kaarten i.p.v. een scrollende tabel -- zie
       .admin-users-table-wrap / .admin-users-cards in app.css voor de media
       query die tussen de twee schakelt. #}
    {% if users is not empty %}
    <div class="admin-users-cards">
        {% for user in users %}
        <div class="admin-users-card" data-list-search-target="card" data-search="{{ (user.displayName ~ ' ' ~ user.email)|lower }}">
            <div class="admin-users-card-name">{{ user.displayName }}</div>
            <div class="admin-users-card-email">{{ user.email }}</div>

            <div class="admin-users-card-roles">
                {% for role in user.roles %}
                    {% if role != 'ROLE_USER' %}
                    <span class="role-badge">{{ role|replace({'ROLE_': ''}) }}</span>
                    {% endif %}
                {% endfor %}
            </div>

            <dl class="admin-users-card-meta">
                <div><dt>Aangemaakt</dt><dd>{{ user.createdAt|date('d-m-Y') }}</dd></div>
                <div><dt>Laatste login</dt><dd>{{ user.lastLoginAt ? user.lastLoginAt|date('d-m-Y H:i') : '–' }}</dd></div>
                <div><dt>Apparaten</dt><dd>{{ push_device_counts[user.id] ?? 0 }}</dd></div>
            </dl>

            <div class="admin-users-card-actions">
                <a class="btn btn-sm" href="{{ path('admin_users_edit', {id: user.id}) }}">Bewerken</a>
                {% if user != app.user %}
                <form method="post" action="{{ path('admin_users_delete', {id: user.id}) }}" class="form-inline"
                      data-controller="confirm-submit"
                      data-confirm-submit-message-value="Gebruiker {{ user.email }} verwijderen?"
                      data-action="submit->confirm-submit#submit">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_user_delete_' ~ user.id) }}">
                    <button type="submit" class="btn-danger-inline">Verwijderen</button>
                </form>
                {% endif %}
            </div>
        </div>
        {% endfor %}
    </div>
    {% endif %}

    {# Buiten zowel de tabel (desktop) als de kaarten (mobiel) -- die
       wisselen elkaar af via display:none op basis van viewportbreedte, dus
       een melding bínnen een van de twee zou op het andere formaat
       onzichtbaar blijven. #}
    {% if users is not empty %}
    <p class="text-muted list-search-empty" data-list-search-target="empty" hidden>Geen gebruikers gevonden voor deze zoekopdracht.</p>
    {% endif %}

</div>
{% endblock %}
