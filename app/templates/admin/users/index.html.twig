{% extends 'base.html.twig' %}

{% block title %}Gebruikersbeheer – Bijbel Vergelijking{% endblock %}

{% block body %}
<div class="container container--wide">

    <div class="admin-page-header">
        <h1>Gebruikersbeheer</h1>
        <a href="{{ path('admin_users_new') }}" class="btn btn-primary">+ Nieuwe gebruiker</a>
    </div>

    {% for label, messages in app.flashes %}
        {% for message in messages %}
        <div class="alert alert-{{ label }}">{{ message }}</div>
        {% endfor %}
    {% endfor %}

    <table class="admin-table">
        <thead>
            <tr>
                <th>Naam</th>
                <th>E-mail</th>
                <th>Rollen</th>
                <th>Aangemaakt</th>
                <th>Laatste login</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        {% for user in users %}
            <tr>
                <td>{{ user.displayName }}</td>
                <td>{{ user.email }}</td>
                <td>
                    {% for role in user.roles %}
                        {% if role != 'ROLE_USER' %}
                        <span class="role-badge">{{ role|replace({'ROLE_': ''}) }}</span>
                        {% endif %}
                    {% endfor %}
                </td>
                <td>{{ user.createdAt|date('d-m-Y') }}</td>
                <td>{{ user.lastLoginAt ? user.lastLoginAt|date('d-m-Y H:i') : '–' }}</td>
                <td>
                    <a href="{{ path('admin_users_edit', {id: user.id}) }}">Bewerken</a>
                    {% if user != app.user %}
                    <form method="post" action="{{ path('admin_users_delete', {id: user.id}) }}" class="form-inline" onsubmit="return confirm('Gebruiker {{ user.email|e('js') }} verwijderen?')">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_user_delete_' ~ user.id) }}">
                        <button type="submit" class="btn-danger-inline">Verwijderen</button>
                    </form>
                    {% endif %}
                </td>
            </tr>
        {% else %}
            <tr class="empty-row"><td colspan="6">Geen gebruikers gevonden.</td></tr>
        {% endfor %}
        </tbody>
    </table>

</div>
{% endblock %}
