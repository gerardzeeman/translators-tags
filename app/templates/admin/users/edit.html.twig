{% extends 'base.html.twig' %}

{% block title %}Gebruiker bewerken – Bijbel Vergelijking{% endblock %}

{% block body %}
<div class="container container--narrow">

    <h1 class="page-heading">Gebruiker bewerken</h1>

    {% if error %}
    <div class="alert alert-error">{{ error }}</div>
    {% endif %}

    <form method="post">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_user_edit_' ~ user.id) }}">

        <div class="form-group">
            <label>E-mailadres</label>
            <p class="email-display">{{ user.email }}</p>
        </div>

        <div class="form-group">
            <label for="display_name">Naam</label>
            <input type="text" id="display_name" name="display_name" value="{{ user.displayName }}" required minlength="2" class="form-control">
        </div>

        <div class="form-group form-group--last">
            <label>Rollen</label>
            {% for value, label in assignable_roles %}
            <div class="role-option">
                <label>
                    <input type="checkbox" name="roles[]" value="{{ value }}"
                        {{ value in user.roles ? 'checked' : '' }}>
                    {{ label }} <small class="text-muted">({{ value }})</small>
                </label>
            </div>
            {% endfor %}
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Opslaan</button>
            <a href="{{ path('admin_users_index') }}" class="btn btn-secondary">Annuleren</a>
        </div>
    </form>

</div>
{% endblock %}
