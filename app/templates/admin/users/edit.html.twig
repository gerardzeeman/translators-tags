{% extends 'base.html.twig' %}

{% block title %}Gebruiker bewerken – Bijbel Vergelijking{% endblock %}

{% block body %}
<div class="container" style="max-width:520px;margin:2rem auto;padding:0 1rem">

    <h1 style="font-size:1.6rem;font-weight:500;margin-bottom:1.5rem">Gebruiker bewerken</h1>

    {% if error %}
    <div class="alert alert-error" style="margin-bottom:1rem">{{ error }}</div>
    {% endif %}

    <form method="post">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_user_edit_' ~ user.id) }}">

        <div class="form-group" style="margin-bottom:1rem">
            <label>E-mailadres</label>
            <p style="padding:.5rem 0;color:var(--color-muted)">{{ user.email }}</p>
        </div>

        <div class="form-group" style="margin-bottom:1rem">
            <label for="display_name">Naam</label>
            <input type="text" id="display_name" name="display_name" value="{{ user.displayName }}" required minlength="2" class="form-control">
        </div>

        <div class="form-group" style="margin-bottom:1.5rem">
            <label>Rollen</label>
            {% for value, label in assignable_roles %}
            <div style="margin-top:.4rem">
                <label style="display:flex;align-items:center;gap:.5rem;font-weight:normal">
                    <input type="checkbox" name="roles[]" value="{{ value }}"
                        {{ value in user.roles ? 'checked' : '' }}>
                    {{ label }} <small style="color:var(--color-muted)">({{ value }})</small>
                </label>
            </div>
            {% endfor %}
        </div>

        <div style="display:flex;gap:1rem">
            <button type="submit" class="btn btn-primary">Opslaan</button>
            <a href="{{ path('admin_users_index') }}" class="btn btn-secondary">Annuleren</a>
        </div>
    </form>

</div>
{% endblock %}
