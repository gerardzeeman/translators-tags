{% extends 'base.html.twig' %}

{% block title %}Nieuwe gebruiker – Bijbel Vergelijking{% endblock %}

{% block body %}
<div class="container container--narrow">

    <h1 class="page-heading">Nieuwe gebruiker aanmaken</h1>

    {% if error %}
    <div class="alert alert-error">{{ error }}</div>
    {% endif %}

    <form method="post">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_user_new') }}">

        <div class="form-group">
            <label for="display_name">Naam</label>
            <input type="text" id="display_name" name="display_name" required minlength="2" class="form-control">
        </div>

        <div class="form-group">
            <label for="email">E-mailadres</label>
            <input type="email" id="email" name="email" required class="form-control">
        </div>

        <div class="form-group">
            <label for="password">Tijdelijk wachtwoord <small class="text-muted">(minimaal 8 tekens)</small></label>
            <input type="password" id="password" name="password" required minlength="8" autocomplete="new-password" class="form-control">
        </div>

        <div class="form-group form-group--last">
            <label>Rollen</label>
            {% for value, label in assignable_roles %}
            <div class="role-option">
                <label>
                    <input type="checkbox" name="roles[]" value="{{ value }}">
                    {{ label }} <small class="text-muted">({{ value }})</small>
                </label>
            </div>
            {% endfor %}
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Aanmaken</button>
            <a href="{{ path('admin_users_index') }}" class="btn btn-secondary">Annuleren</a>
        </div>
    </form>

</div>
{% endblock %}
