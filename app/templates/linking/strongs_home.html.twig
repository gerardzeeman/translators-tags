{% extends 'base.html.twig' %}
{% block title %}Strong's koppelen – Bijbel Vergelijking{% endblock %}

{% block body %}
<div class="page-strongs-home">
    <h1>Koppelen per Strong's</h1>
    <p>
        Voer een Strong's nummer in om alle voorkomens te bekijken en te koppelen.
    </p>

    <form class="strongs-home-card"
          data-controller="strongs-select"
          action="#">

        <div class="form-group">
            <label for="strongs-translation">Vertaling</label>
            <select id="strongs-translation"
                    data-strongs-select-target="translation">
                {% for t in translations %}
                {% if translation_visible(t) %}
                <option value="{{ t.code }}">{{ t.name }}</option>
                {% endif %}
                {% endfor %}
            </select>
        </div>

        <div class="form-group">
            <label for="strongs-search">Strong's nummer</label>
            <input type="text"
                   id="strongs-search"
                   placeholder="bijv. H0430 of G2316"
                   data-strongs-select-target="input"
                   data-action="keydown.enter->strongs-select#navigate">
            <p class="field-hint">
                H = Hebreeuws (OT) &nbsp;·&nbsp; G = Grieks (NT)
            </p>
        </div>

        <button type="button"
                class="btn-primary"
                data-action="click->strongs-select#navigate">
            Zoek woord →
        </button>

    </form>
</div>
{% endblock %}
