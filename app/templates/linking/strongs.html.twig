{% extends 'base.html.twig' %}
{% block title %}{{ strongs }} – Koppelen per Strong's{% endblock %}

{% block body %}
<div class="page-strongs-linking">

    {# ── Header ───────────────────────────────────────────────────────────── #}
    <div class="strongs-header">
        <a href="{{ path('app_linking_strongs_home') }}" class="back-link">← Terug</a>
        <h1 class="strongs-title">
            <span class="strongs-badge">{{ strongs }}</span>
        </h1>

        {# Translation switcher — HSV only shown to users with ROLE_HSV #}
        <div class="translation-switcher">
            {% for t in translations %}
            {% if t.code == 'SV' or is_granted('ROLE_HSV') %}
            <a href="{{ path('app_linking_strongs', {translation: t.code, strongs: strongs}) }}"
               class="trans-btn {% if t.id == translation.id %}trans-btn-active{% endif %}">
                {{ t.code }}
            </a>
            {% endif %}
            {% endfor %}
        </div>

        {# Transliterations sorted by occurrence #}
        {% if transliterations|length > 0 %}
        <div class="translits-row">
            {% for t in transliterations %}
            <span class="translit-chip" title="{{ t.occurrence_count }} voorkomens">
                {{ t.transliteration }}
                <span class="occ-count">{{ t.occurrence_count }}×</span>
            </span>
            {% endfor %}
        </div>
        {% endif %}

        {# Progress bar #}
        {% set total  = progress.total|default(0) %}
        {% set manual = progress.manual|default(0) %}
        {% set linked = progress.linked|default(0) %}
        {% set pct_manual = total > 0 ? (manual / total * 100)|round : 0 %}
        {% set pct_linked = total > 0 ? (linked / total * 100)|round : 0 %}

        <div class="progress-block">
            <div class="progress-labels">
                <span>Voortgang koppelen</span>
                <span>
                    <strong id="progress-count-manual">{{ manual }}</strong> handmatig ·
                    <strong id="progress-count-linked">{{ linked }}</strong> totaal gekoppeld ·
                    <strong id="progress-count-total">{{ total }}</strong> woorden
                </span>
            </div>
            <div class="progress-bar-track">
                {# Layered bar: total linked (blue) underneath, manual (green) on top #}
                <div id="progress-bar-linked" class="progress-bar-linked" style="width: {{ pct_linked }}%"></div>
                <div id="progress-bar-manual" class="progress-bar-manual" style="width: {{ pct_manual }}%"></div>
            </div>
            <div id="progress-pct" class="progress-pct">{{ pct_manual }}% handmatig bevestigd</div>
        </div>
    </div>

    {# ── Strong's dictionary entry ───────────────────────────────────────── #}
    {% if strongs_entry %}
    <div class="strongs-entry">
        <div class="strongs-entry-word">
            {% if strongs_entry.lemma %}
            <span class="strongs-lemma {% if strongs_entry.lang == 'HE' %}strongs-lemma-he{% endif %}">
                {{- strongs_entry.lemma -}}
            </span>
            {% endif %}
            {% if strongs_entry.transliteration %}
            <span class="strongs-translit">{{ strongs_entry.transliteration }}</span>
            {% endif %}
            {% if strongs_entry.pronunciation %}
            <span class="strongs-pronun">({{ strongs_entry.pronunciation }})</span>
            {% endif %}
            {% if strongs_entry.pos %}
            <span class="strongs-pos">{{ strongs_entry.pos }}</span>
            {% endif %}
        </div>

        {% set short_def_display   = strongs_entry.short_def_nl|default(null) ?: strongs_entry.short_def|default(null) %}
        {% set definition_display  = strongs_entry.definition_nl|default(null) ?: strongs_entry.definition|default(null) %}
        {% set etymology_display   = strongs_entry.etymology_nl|default(null) ?: strongs_entry.etymology|default(null) %}

        {% if short_def_display %}
        <p class="strongs-short-def">{{ short_def_display }}</p>
        {% endif %}

        {% if definition_display %}
        <ul class="strongs-definition">
            {% for line in definition_display|split('\n') %}
            {% if line|trim %}
            <li>{{ line|replace({'1) ': '', '2) ': '', '3) ': '', '4) ': '', '5) ': '', '6) ': '', '7) ': '', '8) ': '', '9) ': ''})|trim }}</li>
            {% endif %}
            {% endfor %}
        </ul>
        {% endif %}

        <div class="strongs-meta">
            {% if etymology_display %}
            <div class="strongs-meta-row">
                <span class="strongs-meta-label">Herkomst</span>
                <span>{{ etymology_display }}</span>
            </div>
            {% endif %}
            {% if strongs_entry.kjv_renderings %}
            <div class="strongs-meta-row">
                <span class="strongs-meta-label">KJV</span>
                <span>{{ strongs_entry.kjv_renderings }}</span>
            </div>
            {% endif %}
        </div>
    </div>
    {% endif %}

    {# ── Legend ───────────────────────────────────────────────────────────── #}
    <div class="linking-legend" style="margin-bottom:1.5rem;">
        <span><span class="dot method-manual"></span> Handmatig</span>
        <span><span class="dot method-manual-empty"></span> Handmatig leeg</span>
        <span><span class="dot method-manual_hint"></span> Hint</span>
        <span><span class="dot method-proper_noun"></span> Eigennaam</span>
        <span><span class="dot method-positional"></span> Positioneel</span>
        <span><span class="dot method-none"></span> Geen</span>
    </div>

    {# ── Verse list ───────────────────────────────────────────────────────── #}
    {% if verses|length == 0 %}
    <p class="no-results">Geen verzen gevonden voor {{ strongs }}.</p>
    {% else %}

    <div class="strongs-verses">
        {% for v in verses %}
            {% include 'linking/_strongs_verse_block.html.twig' with {v: v, strongs: strongs} %}
        {% endfor %}
    </div>
    {% endif %}

</div>
{% endblock %}
