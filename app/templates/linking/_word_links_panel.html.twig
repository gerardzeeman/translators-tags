<turbo-frame id="word-links-panel">
{% if translations|length > 0 %}
<div class="word-links-list">
    {% for t in translations %}
    <div class="word-links-entry">
        <div class="word-links-entry-head">
            <span class="trans-badge">{{ t.translation_code }}</span>
            <span class="word-links-ref">
                {{ t.book_name }} {{ t.chapter }}:{{ t.verse }}
            </span>
        </div>

        <div class="word-links-confidence-table-wrap">
        <table class="word-links-confidence-table">
            <thead>
                <tr>
                    <th>Woord</th>
                    <th>Methode</th>
                    <th>Score</th>
                    <th>Notities</th>
                    <th>Aangemaakt</th>
                    <th>Door</th>
                    <th>Link ID</th>
                    <th>TW ID</th>
                </tr>
            </thead>
            <tbody>
                {% for link in t.links %}
                {% set word_cell %}
                    “{{ link.word_text }}”{% if link.is_filler %} <span class="word-filler-tag" title="Cursief woord zonder directe brontaalbasis">toegevoegd</span>{% endif %}
                {% endset %}
                {% if link.confidences|length > 0 %}
                    {% for c in link.confidences %}
                    <tr>
                        <td class="word-links-tw">{{ word_cell }}</td>
                        <td><span class="dot method-{{ c.method }}"></span> {{ c.method }}</td>
                        <td>{{ c.score is not null ? (c.score * 100)|round ~ '%' : '–' }}</td>
                        <td>{{ c.notes ?: '–' }}</td>
                        <td>{{ c.created_at ? c.created_at|date('d-m-Y H:i') : '–' }}</td>
                        <td>
                            {% if c.created_by_name %}
                                {{ c.created_by_name }}{% if c.created_by_email %} <span class="word-links-email">({{ c.created_by_email }})</span>{% endif %}
                            {% else %}
                                automatisch
                            {% endif %}
                        </td>
                        <td class="word-links-id-cell">{{ link.link_id }}</td>
                        <td class="word-links-id-cell">{{ link.tw_id }}</td>
                    </tr>
                    {% endfor %}
                {% else %}
                    <tr>
                        <td class="word-links-tw">{{ word_cell }}</td>
                        <td colspan="4" class="word-links-no-confidence">Geen confidence-gegevens</td>
                        <td class="word-links-id-cell">{{ link.link_id }}</td>
                        <td class="word-links-id-cell">{{ link.tw_id }}</td>
                    </tr>
                {% endif %}
                {% endfor %}
            </tbody>
        </table>
        </div>
    </div>
    {% endfor %}
</div>
{% else %}
<p class="strongs-placeholder">Dit woord heeft nog geen koppelingen.</p>
{% endif %}
</turbo-frame>
