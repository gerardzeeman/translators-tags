{% extends 'base.html.twig' %}
{% block title %}{{ book.nameNl }} {{ chapter }}:{{ verse }} – Koppelen{% endblock %}
{% block head %}<meta name="csrf-token" content="{{ csrf_token('linking_api') }}">{% endblock %}

{% block body %}
<div class="page-linking" data-controller="word-linker"
     data-word-linker-save-url-value="{{ path('api_linking_save') }}"
     data-word-linker-delete-url-value="{{ path('api_linking_delete', {linkId: 0}) }}"
     data-word-linker-translation-id-value="{{ translation.id }}">

    {# ── Top bar ──────────────────────────────────────────────────────────── #}
    <div class="linking-topbar">
        <nav class="breadcrumb">
            <a href="{{ path('app_linking_home') }}">Koppelen</a> ›
            <a href="{{ path('app_linking_home') }}">{{ book.nameNl }}</a> ›
            <strong>{{ chapter }}:{{ verse }}</strong>
        </nav>

        <div class="linking-nav">
            {% if nav.prev %}
            <a href="{{ path('app_linking_passage', nav.prev) }}" class="nav-btn nav-btn-text">‹ Vorig</a>
            {% endif %}
            <span class="verse-ref">{{ book.nameNl }} {{ chapter }}:{{ verse }}</span>
            {% if nav.next %}
            <a href="{{ path('app_linking_passage', nav.next) }}" class="nav-btn nav-btn-text">Volgend ›</a>
            {% endif %}

        </div>

        {# Translation switcher — restricted translations only shown to users with the matching viewer role #}
        <div class="translation-switcher">
            {% for t in translations %}
            {% if translation_visible(t) %}
            <a href="{{ path('app_linking_passage', {translation: t.code, usfm: book.usfmCode, chapter: chapter, verse: verse}) }}"
               class="trans-btn {% if t.id == translation.id %}trans-btn-active{% endif %}">
                {{ t.abbreviation }}
            </a>
            {% endif %}
            {% endfor %}
        </div>

        {# Mobiele variant van bovenstaande — dropdown i.p.v. een knoppenrij die op smalle schermen wrapt #}
        <select class="translation-switcher-mobile"
                aria-label="Vertaling"
                data-controller="select-navigate"
                data-action="change->select-navigate#navigate">
            {% for t in translations %}
            {% if translation_visible(t) %}
            <option value="{{ path('app_linking_passage', {translation: t.code, usfm: book.usfmCode, chapter: chapter, verse: verse}) }}"
                    {% if t.id == translation.id %}selected{% endif %}>
                {{ t.name }}
            </option>
            {% endif %}
            {% endfor %}
        </select>

        <div class="linking-legend">
            <span><span class="dot method-manual"></span> Handmatig</span>
            <span><span class="dot method-manual-empty"></span> Handmatig leeg</span>
            <span><span class="dot method-manual_hint"></span> Hint</span>
            <span><span class="dot method-proper_noun"></span> Eigennaam</span>
            <span><span class="dot method-positional"></span> Positioneel</span>
            <span><span class="dot method-none"></span> Geen</span>
        </div>
    </div>

    {# ── Status bar ───────────────────────────────────────────────────────── #}
    <div class="linking-status-bar">
        <span class="linking-status" role="status" aria-live="polite" data-word-linker-target="status">
            Klik een bronwoord om te selecteren, dan klik één of meerdere Nederlandse woorden.
        </span>
        {% set proposal_count = passage.source_words|filter(w => w.propagated is defined and w.propagated and w.links|length > 0)|length %}
        {% if proposal_count > 0 %}
        <button type="button"
                class="btn-confirm-proposals"
                data-action="click->word-linker#confirmAllProposals"
                data-word-linker-target="confirmProposalsButton"
                title="Bevestig alle {{ proposal_count }} voorstellen als handmatige koppeling">
            ✓ Bevestig alle voorstellen ({{ proposal_count }})
        </button>
        <button type="button"
                class="btn-cancel-proposals"
                hidden
                data-action="click->word-linker#cancelConfirmAllProposals"
                data-word-linker-target="cancelProposalsButton">
            Annuleren
        </button>
        {% endif %}
    </div>

    {# ── Main linking area ────────────────────────────────────────────────── #}
    <div class="linking-area">

        {# Source language panel #}
        <section class="link-panel link-panel-source">
            <h2 class="panel-label">
                {% if passage.testament == 'OT' %}
                    <span class="lang-badge lang-he">עִבְרִית</span> Hebreeuws
                {% else %}
                    <span class="lang-badge lang-gk">Ἑλληνικά</span> Grieks
                {% endif %}
            </h2>

            <div class="source-words-grid {% if passage.testament == 'OT' %}rtl{% endif %}">
                {% for word in passage.source_words %}
                {% set lang = passage.testament == 'OT' ? 'HE' : 'GR' %}
                {% set linked_tw_ids = word.links|map(l => l.tw_id)|join(',') %}
                {% set best_method = word.links|length > 0 ? word.links|first.method : (word.is_manually_empty ? 'manual-empty' : 'none') %}
                {% set is_propagated = word.propagated is defined and word.propagated %}

                <div class="src-word method-border-{{ best_method }}{% if is_propagated %} src-word-propagated{% endif %}"
                     role="button"
                     tabindex="0"
                     aria-pressed="false"
                     aria-label="{{ word.word_text }}{% if word.strongs %} ({{ word.strongs }}){% endif %}"
                     data-manually-empty="{{ word.is_manually_empty ? '1' : '0' }}"
                     data-source-id="{{ word.id }}"
                     data-lang="{{ lang }}"
                     data-strongs="{{ word.strongs }}"
                     data-strongs-url="{{ word.strongs ? path('app_strongs', {number: word.strongs}) : '' }}"
                     {% if is_granted('ROLE_LINKER') %}data-word-links-url="{{ path('api_linking_word_links', {lang: lang, sourceId: word.id}) }}"{% endif %}
                     data-linked-tw-ids="{{ linked_tw_ids }}"
                     data-action="click->word-linker#selectSource keydown.enter->word-linker#selectSource keydown.space->word-linker#selectSource"
                     data-word-linker-target="sourceWord">

                    <span class="src-text">{{ word.word_text }}</span>

                    {% if word.transliteration %}
                    <span class="src-translit">{{ word.transliteration }}</span>
                    {% endif %}

                    {% if word.strongs %}
                    <div class="word-popup">
                        <span class="src-strongs">{{ word.strongs }}</span>
                    </div>
                    {% endif %}

                    <div class="src-links">
                        {% if is_propagated %}
                        <span class="propagated-hint" title="Afgeleid via SV-koppeling — klik om te bevestigen">↝ voorstel</span>
                        {% endif %}
                        {% for link in word.links %}
                        {% if link.link_id is not null %}
                        <span class="link-chip method-{{ link.method }}"
                              role="button"
                              tabindex="0"
                              aria-label="Verwijder koppeling ({{ link.method }})"
                              data-link-id="{{ link.link_id }}"
                              data-tw-id="{{ link.tw_id }}"
                              data-action="click->word-linker#deleteLink keydown.enter->word-linker#deleteLink"
                              title="{{ link.method }}: {{ ((link.score ?? 0) * 100)|round }}% — klik om te verwijderen">
                            ×
                        </span>
                        {% endif %}
                        {% endfor %}
                        {% if word.is_manually_empty %}
                        <span class="link-chip method-manual-empty" tabindex="0" title="Handmatig: geen koppeling">∅</span>
                        {% endif %}
                    </div>
                </div>
                {% endfor %}
            </div>
        </section>

        {# Dutch translation panel #}
        <section class="link-panel link-panel-dutch">
            <h2 class="panel-label">
                <span class="lang-badge lang-nl">NL</span>
                {{ translation.name }}{% if translation.abbreviation %} {{ translation.abbreviation }}{% endif %}
            </h2>

            <div class="dutch-words-flow">
                {% for word in passage.dutch_words %}
                {% set linked = word.links|length > 0 %}
                {% set best_method = linked ? word.links|first.method : 'none' %}

                <span class="nl-word method-underline-{{ best_method }}{% if word.is_filler %} word-filler{% endif %}"
                      role="button"
                      tabindex="0"
                      aria-pressed="false"
                      data-tw-id="{{ word.id }}"
                      data-action="click->word-linker#selectDutch keydown.enter->word-linker#selectDutch keydown.space->word-linker#selectDutch"
                      data-word-linker-target="dutchWord">
                    {{- word.word_text -}}
                </span>{{- word.punct_after ?? '' -}}{{ ' ' }}
                {% endfor %}
            </div>

            {% if passage.dutch_words|length > 0 %}
            <p class="verse-full-text">
                <em>{{ passage.dutch_words|first.verse_text }}</em>
            </p>
            {% endif %}
        </section>

        {# Strong's detail panel — loaded when a source word is selected #}
        <section class="link-panel link-panel-strongs">
            <h2 class="panel-label">Strong's</h2>
            <turbo-frame id="strongs-panel">
                <p class="strongs-placeholder">Selecteer een bronwoord om details te zien.</p>
            </turbo-frame>
        </section>

        {# All links for a word — review data, linkers only #}
        {% if is_granted('ROLE_LINKER') %}
        <section class="link-panel link-panel-word-links">
            <h2 class="panel-label">Alle links</h2>
            <turbo-frame id="word-links-panel">
                <p class="strongs-placeholder">Selecteer een bronwoord om alle koppelingen te zien.</p>
            </turbo-frame>
        </section>
        {% endif %}

    </div>

    {# ── Action bar (shown when a source word is selected) ────────────────── #}
    <div class="action-bar action-bar-inline" data-word-linker-target="actionBar">
        <div class="action-bar-inner">
            <span class="action-label">
                Geselecteerd: <strong data-word-linker-target="selectedLabel">–</strong>
            </span>
            <span class="action-hint">
                Klik Nederlandse woorden om te selecteren/deselecteren
            </span>
            <div class="action-buttons">
                <button class="btn-save"
                        data-action="click->word-linker#saveLinks">
                    ✓ Koppeling opslaan
                </button>
                <button class="btn-cancel"
                        data-action="click->word-linker#cancel">
                    Annuleren
                </button>
            </div>
        </div>
    </div>

</div>
{% endblock %}
