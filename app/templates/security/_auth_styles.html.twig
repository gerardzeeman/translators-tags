<style>
    {# Gedeelde stijl voor login.html.twig en register.html.twig — voorheen
       stond dit blok (~90 regels) in beide bestanden gedupliceerd, met het
       risico dat ze na een toekomstige aanpassing uit de pas gaan lopen. #}
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
        --color-parchment: #f6efe1;
        --color-card:      #fffdf8;
        --color-ink:       #241b0f;
        --color-ink-light: #55492f;
        --color-ink-muted: #8c7c5e;
        --color-border:    #ddd0ae;
        --color-accent:    #7a3b1e;
        --color-accent-2:  #1e4d7a;
        --color-error-bg:  #fdf0ee;
        --color-error:     #922;
        --font-serif:      'Baskervville', Georgia, 'Times New Roman', serif;
        --font-sans:       'Public Sans', -apple-system, 'Segoe UI', Arial, sans-serif;
    }

    body {
        background: var(--color-parchment);
        font-family: var(--font-sans);
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 2rem;
    }

    .auth-card {
        background: var(--color-card);
        border: 1px solid var(--color-border);
        border-radius: 10px;
        padding: 2.5rem 3rem;
        width: 100%;
        max-width: 440px;
        box-shadow: 0 2px 8px rgba(36,27,15,.06), 0 8px 32px rgba(36,27,15,.05);
    }

    .auth-logo {
        text-align: center;
        margin-bottom: 2rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: .5rem;
    }
    .auth-logo .logo-title {
        font-size: .95rem;
        color: var(--color-ink-muted);
        letter-spacing: .06em;
    }

    h1 {
        font-family: var(--font-serif);
        font-size: 1.6rem;
        font-weight: 400;
        color: var(--color-ink);
        margin-bottom: 1.5rem;
        text-align: center;
    }

    .alert {
        padding: .75rem 1rem;
        border-radius: 4px;
        margin-bottom: 1.25rem;
        font-size: .9rem;
    }
    .alert-error   { background: var(--color-error-bg); color: var(--color-error); border: 1px solid #f0b8b0; }
    .alert-success { background: #edf7ed; color: #2a6a2a; border: 1px solid #b8ddb8; }

    .form-group {
        margin-bottom: 1.25rem;
    }
    label {
        display: block;
        font-size: .85rem;
        color: var(--color-ink-light);
        margin-bottom: .35rem;
    }
    .field-hint { font-size: .75rem; color: var(--color-ink-muted); margin-top: .25rem; }

    input[type="email"],
    input[type="password"],
    input[type="text"] {
        width: 100%;
        padding: .6rem .85rem;
        border: 1px solid var(--color-border);
        border-radius: 4px;
        font-family: var(--font-sans);
        font-size: 1rem;
        color: var(--color-ink);
        background: #fdfbf5;
        transition: border-color .15s;
        outline: none;
    }
    input:focus {
        border-color: var(--color-accent);
        box-shadow: 0 0 0 3px rgba(122,59,30,.12);
    }
    input[aria-invalid="true"] {
        border-color: var(--color-error);
        box-shadow: 0 0 0 3px rgba(153,34,34,.12);
    }

    .form-check {
        display: flex;
        align-items: center;
        gap: .5rem;
        font-size: .85rem;
        color: var(--color-ink-light);
        margin-bottom: 1.5rem;
    }
    .form-check input[type="checkbox"] { width: auto; }

    .btn-primary {
        width: 100%;
        padding: .7rem;
        background: var(--color-accent);
        color: #fff;
        border: none;
        border-radius: 4px;
        font-family: var(--font-sans);
        font-weight: 600;
        font-size: 1rem;
        cursor: pointer;
        transition: background .15s;
        letter-spacing: .02em;
    }
    .btn-primary:hover { background: #8f4a26; }

    .auth-footer {
        text-align: center;
        margin-top: 1.5rem;
        font-size: .85rem;
        color: var(--color-ink-muted);
    }
    .auth-footer a { color: var(--color-accent-2); }

    .divider {
        border: none;
        border-top: 1px solid var(--color-border);
        margin: 1.5rem 0;
    }
</style>
