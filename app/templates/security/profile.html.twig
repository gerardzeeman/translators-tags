{% extends 'base.html.twig' %}
{% block title %}Mijn profiel – Bijbel Vergelijking{% endblock %}

{% block body %}
<div class="profile-page">
    <h1>Mijn profiel</h1>

    {% if error %}
    <div class="alert alert-error">
        {{ error }}
    </div>
    {% endif %}

    {% if success %}
    <div class="alert alert-success">
        {{ success }}
    </div>
    {% endif %}

    {# Account info #}
    <section class="profile-card">
        <h2>Accountgegevens</h2>
        <p class="profile-field"><strong>E-mail:</strong> {{ user.email }}</p>
        {% set role_labels = {
            'ROLE_ADMIN':  'Beheerder',
            'ROLE_LINKER': 'Koppelaar (SV)',
            'ROLE_VIEWER_HSV': 'Herziene Statenvertaling',
            'ROLE_VIEWER': 'Lezer',
        } %}
        {% set named_roles = user.roles|filter(r => r != 'ROLE_USER')|map(r => role_labels[r] ?? r)|sort %}
        <p class="profile-field"><strong>Rollen:</strong>
            {{ named_roles|length > 0 ? named_roles|join(', ') : '–' }}
        </p>
        <p class="profile-field"><strong>Lid sinds:</strong> {{ user.createdAt|date('d-m-Y') }}</p>
        {% if user.lastLoginAt %}
        <p><strong>Laatste login:</strong> {{ user.lastLoginAt|date('d-m-Y H:i') }}</p>
        {% endif %}
    </section>

    {# Change display name #}
    <section class="profile-card">
        <h2>Naam wijzigen</h2>
        <form method="post" action="{{ path('app_profile') }}">
            <input type="hidden" name="action" value="update_name">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('profile_name') }}">
            <div class="profile-form-field">
                <label for="display_name" class="form-group__label">Weergavenaam</label>
                <input type="text" id="display_name" name="display_name"
                       value="{{ user.displayName }}"
                       class="form-input"
                       required>
            </div>
            <button type="submit" class="btn-submit">
                Opslaan
            </button>
        </form>
    </section>

    {# Change password #}
    <section class="profile-card">
        <h2>Wachtwoord wijzigen</h2>
        <form method="post" action="{{ path('app_profile') }}">
            <input type="hidden" name="action" value="change_password">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('profile_password') }}">
            <div class="profile-form-field">
                <label for="current_password" class="form-group__label">Huidig wachtwoord</label>
                <input type="password" id="current_password" name="current_password"
                       class="form-input"
                       required>
            </div>
            <div class="profile-form-field">
                <label for="new_password" class="form-group__label">Nieuw wachtwoord</label>
                <input type="password" id="new_password" name="new_password"
                       class="form-input"
                       required>
            </div>
            <div class="profile-form-field--last">
                <label for="confirm_password" class="form-group__label">Bevestig nieuw wachtwoord</label>
                <input type="password" id="confirm_password" name="confirm_password"
                       class="form-input"
                       required>
            </div>
            <button type="submit" class="btn-submit">
                Wachtwoord wijzigen
            </button>
        </form>
    </section>
</div>
{% endblock %}
