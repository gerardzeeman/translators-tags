{% extends 'base.html.twig' %}
{% block title %}Mijn profiel – Bijbel Vergelijking{% endblock %}

{% block head %}
{% if is_granted('ROLE_CGK_RIJNSBURG_NIEUWS') %}
<meta name="csrf-token" content="{{ csrf_token('push_notifications') }}">
{% endif %}
{% endblock %}

{% block body %}
<div class="profile-page">
    <h1>Mijn profiel</h1>

    {% if error %}
    <div class="alert alert-error">
        {{ error }}
    </div>
    {% endif %}

    {% if success %}
    <div class="alert alert-success">
        {{ success }}
    </div>
    {% endif %}

    {# Account info #}
    <section class="profile-card">
        <h2>Accountgegevens</h2>
        <p class="profile-field"><strong>E-mail:</strong> {{ user.email }}</p>
        {% if is_granted('ROLE_ADMIN') %}
        {% set role_labels = {
            'ROLE_ADMIN':  'Beheerder',
            'ROLE_LINKER': 'Koppelaar (SV)',
            'ROLE_VIEWER_HSV': 'Herziene Statenvertaling',
            'ROLE_VIEWER_SVGBS': 'Statenvertaling (GBS)',
            'ROLE_VIEWER': 'Lezer',
        } %}
        {% set named_roles = user.roles|filter(r => r != 'ROLE_USER')|map(r => role_labels[r] ?? r)|sort %}
        <p class="profile-field"><strong>Rollen:</strong>
            {{ named_roles|length > 0 ? named_roles|join(', ') : '–' }}
        </p>
        {% endif %}
        <p class="profile-field"><strong>Lid sinds:</strong> {{ user.createdAt|date('d-m-Y') }}</p>
        {% if is_granted('ROLE_ADMIN') and user.lastLoginAt %}
        <p><strong>Laatste login:</strong> {{ user.lastLoginAt|date('d-m-Y H:i') }}</p>
        {% endif %}
    </section>

    {# Change display name #}
    <section class="profile-card">
        <h2>Naam wijzigen</h2>
        <form method="post" action="{{ path('app_profile') }}">
            <input type="hidden" name="action" value="update_name">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('profile_name') }}">
            <div class="profile-form-field">
                <label for="display_name" class="form-group__label">Weergavenaam</label>
                <input type="text" id="display_name" name="display_name"
                       value="{{ user.displayName }}"
                       class="form-input"
                       required>
            </div>
            <button type="submit" class="btn-submit">
                Opslaan
            </button>
        </form>
    </section>

    {# Change password #}
    <section class="profile-card">
        <h2>Wachtwoord wijzigen</h2>
        <form method="post" action="{{ path('app_profile') }}">
            <input type="hidden" name="action" value="change_password">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('profile_password') }}">
            <div class="profile-form-field">
                <label for="current_password" class="form-group__label">Huidig wachtwoord</label>
                <input type="password" id="current_password" name="current_password"
                       class="form-input"
                       required>
            </div>
            <div class="profile-form-field">
                <label for="new_password" class="form-group__label">Nieuw wachtwoord</label>
                <input type="password" id="new_password" name="new_password"
                       class="form-input"
                       required>
            </div>
            <div class="profile-form-field--last">
                <label for="confirm_password" class="form-group__label">Bevestig nieuw wachtwoord</label>
                <input type="password" id="confirm_password" name="confirm_password"
                       class="form-input"
                       required>
            </div>
            <button type="submit" class="btn-submit">
                Wachtwoord wijzigen
            </button>
        </form>
    </section>

    {# Push-meldingen (docs/push-notifications-plan.md) #}
    {% if is_granted('ROLE_CGK_RIJNSBURG_NIEUWS') %}
    <section class="profile-card"
             data-controller="push-subscribe"
             data-push-subscribe-vapid-public-key-value="{{ vapid_public_key }}"
             data-push-subscribe-subscribe-url-value="{{ path('app_push_subscribe') }}"
             data-push-subscribe-unsubscribe-url-value="{{ path('app_push_unsubscribe') }}">
        <h2>Meldingen</h2>
        <p class="profile-field">
            <label>
                <input type="checkbox" data-push-subscribe-target="toggle" data-action="change->push-subscribe#toggle">
                Dagelijks CGK/Rijnsburg nieuwsoverzicht ontvangen als pushmelding
            </label>
        </p>
        <p class="profile-field" data-push-subscribe-target="status"></p>
        <p class="profile-field" data-push-subscribe-target="unsupported" hidden>
            Pushmeldingen worden niet ondersteund door deze browser.
        </p>
    </section>
    {% endif %}
</div>
{% endblock %}
