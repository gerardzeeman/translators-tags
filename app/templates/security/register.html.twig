<!DOCTYPE html>
<html lang="nl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Registreren – Bijbel Vergelijking</title>
    <link rel="icon" type="image/png" href="/favicon.png">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Baskervville:ital@0;1&family=Public+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">
    {% include 'security/_auth_styles.html.twig' %}
    <style>
        /* Klein, pagina-specifiek accent — geen reden om dit in de gedeelde
           partial op te nemen, dat zou de login-pagina onnodig ook een
           foutmelding-rand op elk veld geven. */
        .field-error { color: var(--color-error); font-size: .75rem; margin-top: .25rem; }
    </style>
    {% if google_analytics_id %}
    <script async nonce="{{ csp_nonce() }}" src="https://www.googletagmanager.com/gtag/js?id={{ google_analytics_id }}"></script>
    <script nonce="{{ csp_nonce() }}">
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', '{{ google_analytics_id }}');
    </script>
    {% endif %}
</head>
<body>
<div class="auth-card">
    <div class="auth-logo">
        <img src="/favicon.svg" width="80" height="80" alt="Alef-Omega logo">
        <span class="logo-title">alefomega.nl</span>
    </div>

    <h1>Account aanmaken</h1>

    {% if error %}
    <div class="alert alert-error" role="alert">{{ error }}</div>
    {% endif %}

    <form method="post" action="{{ path('app_register') }}" data-turbo="false">
        <div class="form-group">
            <label for="display_name">Naam</label>
            <input type="text"
                   id="display_name"
                   name="display_name"
                   value="{{ last_name }}"
                   autocomplete="name"
                   autofocus
                   required>
        </div>

        <div class="form-group">
            <label for="email">E-mailadres</label>
            <input type="email"
                   id="email"
                   name="email"
                   value="{{ last_email }}"
                   autocomplete="email"
                   required>
        </div>

        <div class="form-group">
            <label for="password">Wachtwoord</label>
            <input type="password"
                   id="password"
                   name="password"
                   autocomplete="new-password"
                   required>
            <p class="field-hint">Minimaal 8 tekens</p>
        </div>

        <div class="form-group">
            <label for="confirm_password">Wachtwoord bevestigen</label>
            <input type="password"
                   id="confirm_password"
                   name="confirm_password"
                   autocomplete="new-password"
                   aria-describedby="confirm_password_error"
                   required>
            <p id="confirm_password_error" class="field-error" hidden>De wachtwoorden komen niet overeen.</p>
        </div>

        <input type="hidden" name="_csrf_token" value="{{ csrf_token('register') }}">
        <button type="submit" class="btn-primary">Account aanmaken</button>
    </form>

    <script nonce="{{ csp_nonce() }}">
        (() => {
            const password = document.getElementById('password')
            const confirm  = document.getElementById('confirm_password')
            const error    = document.getElementById('confirm_password_error')
            const check    = () => {
                const mismatch = confirm.value.length > 0 && confirm.value !== password.value
                error.hidden = !mismatch
                confirm.setAttribute('aria-invalid', mismatch ? 'true' : 'false')
            }
            confirm.addEventListener('blur', check)
            confirm.addEventListener('input', () => { if (!error.hidden) check() })
        })()
    </script>

    <hr class="divider">

    <div class="auth-footer">
        Al een account? <a href="{{ path('app_login') }}" data-turbo="false">Inloggen</a>
    </div>
</div>
</body>
</html>
