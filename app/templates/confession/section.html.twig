{% extends 'base.html.twig' %}
{% import 'institutio/_macros.html.twig' as m %}
{% block title %}{{ title }} · {{ heading }} – Bijbel Vergelijking{% endblock %}

{% block nav_bijbel %}
<a href="{{ path('app_confession_index') }}" class="nav-book-btn">Belijdenisgeschriften</a>
{% endblock %}
{% block nav_center %}{% endblock %}

{% block body %}
<div class="page-institutio">

    <nav class="chapter-nav" aria-label="Belijdenisgeschriften navigatie">
        <a href="{{ path('app_confession_toc', {werk: werk}) }}" class="chapter-nav-book">{{ title }}</a>
        <span class="chapter-nav-sep">›</span>
        <span class="chapter-nav-current">{{ heading }}</span>
    </nav>

    <div class="institutio-sections">
        {% for s in segments %}
        <div class="institutio-section" id="s{{ s.section }}">
            <span class="institutio-section-num">{{ s.section }}</span>
            <div class="institutio-sentence-group">
                <div class="institutio-sentence-row">
                    <p class="institutio-sentence-la">{% for part in s.parts %}{%- if part.type == 'text' -%}{{ part.content }}{%- else -%}{{ m.word_hover(part.content, part.lemma, part.gloss) }}{%- endif -%}{% endfor %}</p>
                    {% for layer, text_nl in s.translations %}
                    <p class="institutio-sentence-nl" data-layer="{{ layer }}">{{ text_nl }}</p>
                    {% endfor %}
                    {% if is_granted('ROLE_EDIT_INSTITUTIO_TRNL') %}
                    <a href="{{ path('app_confession_edit_text', {id: s.id}) }}" class="institutio-edit-btn" title="Brontekst corrigeren">✎</a>
                    {% endif %}
                </div>
            </div>
        </div>
        {% endfor %}
    </div>

</div>
{% endblock %}
