{% extends 'base.html.twig' %}
{% block title %}Vertaling corrigeren · {{ translation.ref }} – Bijbel Vergelijking{% endblock %}

{% block nav_center %}{% endblock %}

{% block body %}
<div class="page-institutio">
    <h1>Vertaling corrigeren — {{ translation.ref }}</h1>
    <p class="institutio-home-subtitle">
        Wijzig hier de Nederlandse vertaling (laag "{{ translation.layer }}") om een fout te
        herstellen, bijv. een type- of overtypfout.
    </p>

    <form method="post" action="{{ path('app_confession_save_translation', {segmentId: translation.segment_id, layer: translation.layer}) }}">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('confession_edit_translation') }}">
        <textarea name="text_nl" rows="6" style="width:100%; font-family:serif; font-size:1.1rem;">{{ translation.text_nl }}</textarea>
        <p>
            <label for="note">Notitie (optioneel, waarom deze correctie):</label><br>
            <input type="text" id="note" name="note" style="width:100%">
        </p>
        <button type="submit" class="nav-user-btn">Opslaan</button>
    </form>

    {% if history %}
    <h2 style="margin-top:2rem">Correctiehistorie</h2>
    <ul>
        {% for h in history %}
        <li>
            <strong>{{ h.created_at|date('Y-m-d H:i') }}</strong>
            {% if h.note %} — {{ h.note }}{% endif %}<br>
            <span style="color:#888">{{ h.old_text }}</span> → {{ h.new_text }}
        </li>
        {% endfor %}
    </ul>
    {% endif %}
</div>
{% endblock %}
