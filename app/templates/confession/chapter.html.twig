{% extends 'base.html.twig' %}
{% import 'institutio/_macros.html.twig' as m %}
{% import _self as self %}
{% block title %}{{ title }} {{ chapter }} – Bijbel Vergelijking{% endblock %}

{% macro la_parts(parts) %}{% import 'institutio/_macros.html.twig' as m %}{% for part in parts %}{%- if part.type == 'text' -%}{{ part.content }}{%- else -%}{{ m.word_hover(part.content, part.lemma, part.gloss) }}{%- endif -%}{% endfor %}{% endmacro %}

{# Human-readable labels for translation/variant layers -- purely cosmetic,
   falls back to the raw layer key for any not listed here. Kept local to
   this template rather than in the repository/controller since it's
   presentation-only and every confession template needs its own copy. #}
{% set layer_labels = {
    'denheijer': 'Nederlands (Den Heijer, ca. 1900)',
    'zwanepol-hsv': 'Nederlands (Zwanepol-HSV, 2004/2009)',
    'editio-princeps-1563': 'Latijn — editio princeps 1563 (Lagus/Pithopoeus)',
    'main-latin-1697': 'Latijn — commentaartraditie (o.a. Rudolph, 1697)',
} %}

{% block nav_bijbel %}
<a href="{{ path('app_confession_index') }}" class="nav-book-btn">Belijdenisgeschriften</a>
{% endblock %}
{% block nav_center %}{% endblock %}

{% block body %}
<div class="page-institutio">

    <nav class="chapter-nav" aria-label="Belijdenisgeschriften navigatie">
        <a href="{{ path('app_confession_toc', {werk: werk}) }}" class="chapter-nav-book">{{ title }}</a>
        <span class="chapter-nav-sep">›</span>
        <span class="chapter-nav-current">Hoofdstuk {{ chapter }}</span>

        <div class="chapter-nav-arrows">
            {% if nav.prev %}
            <a href="{{ path('app_confession_chapter', {werk: werk, chapter: nav.prev}) }}" class="nav-btn" title="Vorig hoofdstuk">‹</a>
            {% endif %}
            {% if nav.next %}
            <a href="{{ path('app_confession_chapter', {werk: werk, chapter: nav.next}) }}" class="nav-btn" title="Volgend hoofdstuk">›</a>
            {% endif %}
        </div>
    </nav>

    <div class="institutio-heading institutio-heading-solo">{{ heading }}</div>

    <div class="institutio-sections">
        {% for s in articles %}
        {% if s.zondag is defined and s.zondag %}
        <h2 class="institutio-heading-zondag" id="zondag-{{ s.zondag }}">Zondag {{ s.zondag }}</h2>
        {% endif %}
        <div class="institutio-section" id="art-{{ s.section }}">
            <span class="institutio-section-num">{{ s.section }}</span>
            <div class="institutio-sentence-group">
                {% if werk == 'heidelbergse-catechismus' %}
                {% set ep = s.qa.nl['editio-princeps-1563'] ?? null %}
                {% set nl = s.qa.nl['denheijer'] ?? null %}
                {# Zwanepol-HSV is a copyrighted modern translation, unlike
                   denheijer/editio-princeps-1563 -- gated the same way the
                   Bible-side HSV column is (see chapter_view.html.twig). #}
                {% set zw = is_granted('ROLE_VIEWER_HSV') ? (s.qa.nl['zwanepol-hsv'] ?? null) : null %}
                {% set other_layers = s.qa.nl|filter((v, k) => k not in ['editio-princeps-1563', 'denheijer', 'zwanepol-hsv']) %}
                {% set col_count = 1 + (ep ? 1 : 0) + (nl ? 1 : 0) + (zw ? 1 : 0) + other_layers|length %}
                {% set col_style = '--hc-cols: ' ~ col_count %}
                <div class="institutio-sentence-row institutio-sentence-row--triple institutio-sentence-row--labels" style="{{ col_style }}">
                    {% if ep %}<span class="institutio-layer-label">{{ layer_labels['editio-princeps-1563'] }}</span>{% endif %}
                    <span class="institutio-layer-label">{{ layer_labels['main-latin-1697'] }}</span>
                    {% if nl %}<span class="institutio-layer-label">{{ layer_labels['denheijer'] }}</span>{% endif %}
                    {% if zw %}<span class="institutio-layer-label">{{ layer_labels['zwanepol-hsv'] }}</span>{% endif %}
                    {% for layer, qa_nl in other_layers %}
                    <span class="institutio-layer-label">{{ layer_labels[layer] ?? layer }}</span>
                    {% endfor %}
                </div>
                <div class="institutio-sentence-row institutio-sentence-row--triple" style="{{ col_style }}">
                    {% if ep %}
                    <p class="institutio-sentence-la"><strong>V:</strong> {{ ep.question }}</p>
                    {% endif %}
                    <p class="institutio-sentence-la"><strong>V:</strong> {{ self.la_parts(s.qa.latin.question) }}</p>
                    {% if nl %}
                    <p class="institutio-sentence-nl"><strong>V:</strong> {{ nl.question }}</p>
                    {% endif %}
                    {% if zw %}
                    <p class="institutio-sentence-nl"><strong>V:</strong> {{ zw.question }}</p>
                    {% endif %}
                    {% for layer, qa_nl in other_layers %}
                    <p class="institutio-sentence-nl" data-layer="{{ layer }}"><strong>V:</strong> {{ qa_nl.question }}</p>
                    {% endfor %}
                </div>
                <div class="institutio-sentence-row institutio-sentence-row--triple" style="{{ col_style }}">
                    {% if ep %}
                    <p class="institutio-sentence-la"><strong>A:</strong> {{ ep.answer }}</p>
                    {% endif %}
                    <p class="institutio-sentence-la"><strong>A:</strong> {{ self.la_parts(s.qa.latin.answer) }}</p>
                    {% if nl %}
                    <p class="institutio-sentence-nl"><strong>A:</strong> {{ nl.answer }}</p>
                    {% endif %}
                    {% if zw %}
                    <p class="institutio-sentence-nl"><strong>A:</strong> {{ zw.answer }}</p>
                    {% endif %}
                    {% for layer, qa_nl in other_layers %}
                    <p class="institutio-sentence-nl" data-layer="{{ layer }}"><strong>A:</strong> {{ qa_nl.answer }}</p>
                    {% endfor %}
                    {% if is_granted('ROLE_EDIT_INSTITUTIO_TRNL') %}
                    <a href="{{ path('app_confession_edit_text', {id: s.id}) }}" class="institutio-edit-btn" title="Brontekst corrigeren">✎</a>
                    {% endif %}
                </div>
                {% else %}
                <div class="institutio-sentence-row">
                    <p class="institutio-sentence-la">{{ self.la_parts(s.parts) }}</p>
                    {% for layer, text_nl in s.translations %}
                    <p class="institutio-sentence-nl" data-layer="{{ layer }}">{{ text_nl }}</p>
                    {% endfor %}
                    {% if is_granted('ROLE_EDIT_INSTITUTIO_TRNL') %}
                    <a href="{{ path('app_confession_edit_text', {id: s.id}) }}" class="institutio-edit-btn" title="Brontekst corrigeren">✎</a>
                    {% endif %}
                </div>
                {% endif %}
            </div>
        </div>
        {% endfor %}
    </div>

    {% if rejections %}
    <h2 class="institutio-heading-nl" style="margin-top:2rem">Rejectio Errorum</h2>
    <div class="institutio-sections">
        {% for s in rejections %}
        <div class="institutio-section" id="verw-{{ s.section }}">
            <span class="institutio-section-num">{{ s.section }}</span>
            <div class="institutio-sentence-group">
                <div class="institutio-sentence-row">
                    <p class="institutio-sentence-la">{% for part in s.parts %}{%- if part.type == 'text' -%}{{ part.content }}{%- else -%}{{ m.word_hover(part.content, part.lemma, part.gloss) }}{%- endif -%}{% endfor %}</p>
                    {% for layer, text_nl in s.translations %}
                    <p class="institutio-sentence-nl" data-layer="{{ layer }}">{{ text_nl }}</p>
                    {% endfor %}
                    {% if is_granted('ROLE_EDIT_INSTITUTIO_TRNL') %}
                    <a href="{{ path('app_confession_edit_text', {id: s.id}) }}" class="institutio-edit-btn" title="Brontekst corrigeren">✎</a>
                    {% endif %}
                </div>
            </div>
        </div>
        {% endfor %}
    </div>
    {% endif %}

</div>
{% endblock %}
