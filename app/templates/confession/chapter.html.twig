{% extends 'base.html.twig' %}
{% import 'institutio/_macros.html.twig' as m %}
{% import _self as self %}
{% block title %}{{ title }} {{ chapter }} – Bijbel Vergelijking{% endblock %}

{% macro la_parts(parts) %}{% import 'institutio/_macros.html.twig' as m %}{% for part in parts %}{%- if part.type == 'text' -%}{{ part.content }}{%- else -%}{{ m.word_hover(part.content, part.lemma, part.gloss, part.differs ?? false, part.number ?? null) }}{%- endif -%}{% endfor %}{% endmacro %}

{# Human-readable labels for translation/variant layers -- purely cosmetic,
   falls back to the raw layer key for any not listed here. Kept local to
   this template rather than in the repository/controller since it's
   presentation-only and every confession template needs its own copy. #}
{% set layer_labels = {
    'denheijer': 'Nederlands (Den Heijer, ca. 1900)',
    'zwanepol-hsv': 'Nederlands (Zwanepol-HSV, 2004/2009)',
    'editio-princeps-1563': 'Latijn — editio princeps 1563 (Lagus/Pithopoeus)',
    'main-latin-1697': 'Latijn — commentaartraditie (o.a. Rudolph, 1697)',
} %}

{% block nav_center %}{% endblock %}

{% block body %}
<div class="page-institutio">

    <nav class="chapter-nav" aria-label="Belijdenisgeschriften navigatie">
        <a href="{{ path('app_confession_toc', {werk: werk}) }}" class="chapter-nav-book">{{ title }}</a>
        <span class="chapter-nav-sep">›</span>
        <span class="chapter-nav-current">Hoofdstuk {{ chapter }}</span>

        <div class="chapter-nav-arrows">
            {% if nav.prev %}
            <a href="{{ path('app_confession_chapter', {werk: werk, chapter: nav.prev}) }}" class="nav-btn" title="Vorig hoofdstuk">‹</a>
            {% endif %}
            {% if nav.next %}
            <a href="{{ path('app_confession_chapter', {werk: werk, chapter: nav.next}) }}" class="nav-btn" title="Volgend hoofdstuk">›</a>
            {% endif %}
        </div>
    </nav>

    <div class="institutio-heading institutio-heading-solo">{{ heading }}</div>

    {% if werk == 'heidelbergse-catechismus' %}
    <div class="institutio-hc-diff-bar" data-controller="hc-diff-toggle">
        <button type="button"
                class="institutio-hc-diff-btn"
                data-hc-diff-toggle-target="button"
                data-action="hc-diff-toggle#toggle"
                aria-pressed="false">
            Toon verschillen 1697 t.o.v. 1563
        </button>
        <span class="institutio-hc-diff-hint">Gemarkeerde woorden in de 1697-kolom wijken af van de editio princeps 1563.</span>
    </div>
    {% endif %}

    <div class="institutio-sections">
        {% for s in articles %}
        {% if s.zondag is defined and s.zondag %}
        <h2 class="institutio-heading-zondag" id="zondag-{{ s.zondag }}">Zondag {{ s.zondag }}</h2>
        {% endif %}
        <div class="institutio-section" id="art-{{ s.section }}">
            <span class="institutio-section-num">{{ s.section }}</span>
            <div class="institutio-sentence-group">
                {% if werk == 'heidelbergse-catechismus' %}
                {% set ep = s.qa.nl['editio-princeps-1563'] ?? null %}
                {% set nl = s.qa.nl['denheijer'] ?? null %}
                {# Zwanepol-HSV is a copyrighted modern translation, unlike
                   denheijer/editio-princeps-1563 -- gated the same way the
                   Bible-side HSV column is (see chapter_view.html.twig). #}
                {% set zw = is_granted('ROLE_VIEWER_HSV') ? (s.qa.nl['zwanepol-hsv'] ?? null) : null %}
                {% set other_layers = s.qa.nl|filter((v, k) => k not in ['editio-princeps-1563', 'denheijer', 'zwanepol-hsv']) %}
                {% set col_count = 1 + (ep ? 1 : 0) + (nl ? 1 : 0) + (zw ? 1 : 0) + other_layers|length %}
                {% set col_style = '--hc-cols: ' ~ col_count %}
                {# One block per layer (label+V+A kept together) rather than three
                   parallel rows (all labels, then all V's, then all A's) -- the
                   latter reads fine on desktop where CSS grid lines each row's
                   Nth item up in the same column, but collapsing three independent
                   rows to one column on mobile grouped every label together, then
                   every question, then every answer, with no visual link back to
                   which layer any of them belonged to. #}
                <div class="institutio-hc-layers" style="{{ col_style }}">
                    {% if ep %}
                    <div class="institutio-hc-layer">
                        <span class="institutio-layer-label">{{ layer_labels['editio-princeps-1563'] }}</span>
                        {# Word-hover for this layer uses its own LatinCy tokens
                           (s.qa.editioPrinceps1563, see ConfessionRepository::LATIN_TRANSLATION_LAYER)
                           when available, falling back to plain text otherwise. #}
                        <p class="institutio-sentence-la"><strong>V:</strong> {% if s.qa.editioPrinceps1563 %}{{ self.la_parts(s.qa.editioPrinceps1563.question) }}{% else %}{{ ep.question }}{% endif %}</p>
                        <p class="institutio-sentence-la"><strong>A:</strong> {% if s.qa.editioPrinceps1563 %}{{ self.la_parts(s.qa.editioPrinceps1563.answer) }}{% else %}{{ ep.answer }}{% endif %}</p>
                    </div>
                    {% endif %}
                    <div class="institutio-hc-layer">
                        <span class="institutio-layer-label">{{ layer_labels['main-latin-1697'] }}</span>
                        <p class="institutio-sentence-la"><strong>V:</strong> {{ self.la_parts(s.qa.latin.question) }}</p>
                        <p class="institutio-sentence-la"><strong>A:</strong> {{ self.la_parts(s.qa.latin.answer) }}</p>
                    </div>
                    {% if nl %}
                    <div class="institutio-hc-layer">
                        <span class="institutio-layer-label">{{ layer_labels['denheijer'] }}{% if is_granted('ROLE_EDIT_INSTITUTIO_TRNL') %} <a href="{{ path('app_confession_edit_translation', {segmentId: s.id, layer: 'denheijer'}) }}" class="institutio-edit-btn-inline" title="Vertaling corrigeren">✎</a>{% endif %}</span>
                        <p class="institutio-sentence-nl"><strong>V:</strong> {{ nl.question }}</p>
                        <p class="institutio-sentence-nl"><strong>A:</strong> {{ nl.answer }}</p>
                    </div>
                    {% endif %}
                    {% if zw %}
                    <div class="institutio-hc-layer">
                        <span class="institutio-layer-label">{{ layer_labels['zwanepol-hsv'] }}{% if is_granted('ROLE_EDIT_INSTITUTIO_TRNL') %} <a href="{{ path('app_confession_edit_translation', {segmentId: s.id, layer: 'zwanepol-hsv'}) }}" class="institutio-edit-btn-inline" title="Vertaling corrigeren">✎</a>{% endif %}</span>
                        <p class="institutio-sentence-nl"><strong>V:</strong> {{ zw.question }}</p>
                        <p class="institutio-sentence-nl"><strong>A:</strong> {{ zw.answer }}</p>
                    </div>
                    {% endif %}
                    {% for layer, qa_nl in other_layers %}
                    <div class="institutio-hc-layer">
                        <span class="institutio-layer-label">{{ layer_labels[layer] ?? layer }}{% if is_granted('ROLE_EDIT_INSTITUTIO_TRNL') %} <a href="{{ path('app_confession_edit_translation', {segmentId: s.id, layer: layer}) }}" class="institutio-edit-btn-inline" title="Vertaling corrigeren">✎</a>{% endif %}</span>
                        <p class="institutio-sentence-nl" data-layer="{{ layer }}"><strong>V:</strong> {{ qa_nl.question }}</p>
                        <p class="institutio-sentence-nl" data-layer="{{ layer }}"><strong>A:</strong> {{ qa_nl.answer }}</p>
                    </div>
                    {% endfor %}
                    {% if is_granted('ROLE_EDIT_INSTITUTIO_TRNL') %}
                    <a href="{{ path('app_confession_edit_text', {id: s.id}) }}" class="institutio-edit-btn" title="Brontekst corrigeren">✎</a>
                    {% endif %}
                </div>
                {% else %}
                <div class="institutio-sentence-row">
                    <p class="institutio-sentence-la">{{ self.la_parts(s.parts) }}</p>
                    {% for layer, text_nl in s.translations %}
                    <p class="institutio-sentence-nl" data-layer="{{ layer }}">{{ text_nl }}{% if layer != 'editio-princeps-1563' and is_granted('ROLE_EDIT_INSTITUTIO_TRNL') %} <a href="{{ path('app_confession_edit_translation', {segmentId: s.id, layer: layer}) }}" class="institutio-edit-btn-inline" title="Vertaling corrigeren">✎</a>{% endif %}</p>
                    {% endfor %}
                    {% if is_granted('ROLE_EDIT_INSTITUTIO_TRNL') %}
                    <a href="{{ path('app_confession_edit_text', {id: s.id}) }}" class="institutio-edit-btn" title="Brontekst corrigeren">✎</a>
                    {% endif %}
                </div>
                {% endif %}
            </div>
        </div>
        {% endfor %}
    </div>

    {% if rejections %}
    <h2 class="institutio-heading-nl" style="margin-top:2rem">Rejectio Errorum</h2>
    <div class="institutio-sections">
        {% for s in rejections %}
        <div class="institutio-section" id="verw-{{ s.section }}">
            <span class="institutio-section-num">{{ s.section }}</span>
            <div class="institutio-sentence-group">
                <div class="institutio-sentence-row">
                    <p class="institutio-sentence-la">{% for part in s.parts %}{%- if part.type == 'text' -%}{{ part.content }}{%- else -%}{{ m.word_hover(part.content, part.lemma, part.gloss, false, part.number ?? null) }}{%- endif -%}{% endfor %}</p>
                    {% for layer, text_nl in s.translations %}
                    <p class="institutio-sentence-nl" data-layer="{{ layer }}">{{ text_nl }}{% if layer != 'editio-princeps-1563' and is_granted('ROLE_EDIT_INSTITUTIO_TRNL') %} <a href="{{ path('app_confession_edit_translation', {segmentId: s.id, layer: layer}) }}" class="institutio-edit-btn-inline" title="Vertaling corrigeren">✎</a>{% endif %}</p>
                    {% endfor %}
                    {% if is_granted('ROLE_EDIT_INSTITUTIO_TRNL') %}
                    <a href="{{ path('app_confession_edit_text', {id: s.id}) }}" class="institutio-edit-btn" title="Brontekst corrigeren">✎</a>
                    {% endif %}
                </div>
            </div>
        </div>
        {% endfor %}
    </div>
    {% endif %}

</div>
{% endblock %}
