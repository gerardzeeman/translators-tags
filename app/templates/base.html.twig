<!DOCTYPE html>
<html lang="nl" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" type="image/png" href="/favicon.png">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    {% block head %}{% endblock %}
    <title>{% block title %}Bijbel Vergelijking{% endblock %}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=Frank+Ruhl+Libre:wght@400;700&family=GFS+Didot&display=swap" rel="stylesheet">
    {# CSS direct als link zodat browser styles kent vóór eerste render (voorkomt FOUC) #}
    <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
    {# Thema vóór render toepassen om FOUC bij dark mode te voorkomen #}
    <script nonce="{{ csp_nonce() }}">var t=localStorage.getItem('theme');if(t)document.documentElement.dataset.theme=t;</script>
    {% block stylesheets %}{% endblock %}
    {% if google_analytics_id %}
    <script async nonce="{{ csp_nonce() }}" src="https://www.googletagmanager.com/gtag/js?id={{ google_analytics_id }}"></script>
    <script nonce="{{ csp_nonce() }}">
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', '{{ google_analytics_id }}');
    </script>
    {% endif %}
</head>
<body>

<header class="site-header" data-controller="mobile-nav">
    <nav class="nav-inner">

        {# Logo — altijd zichtbaar #}
        <a href="{{ path('app_home') }}" class="site-logo">
            <svg viewBox="0 0 200 200" width="30" height="30" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <defs>
                    <radialGradient id="bgGrad" cx="50%" cy="36%" r="68%">
                        <stop offset="0%" stop-color="#301e10"/>
                        <stop offset="100%" stop-color="#0c0805"/>
                    </radialGradient>
                    <radialGradient id="shineGrad" cx="50%" cy="20%" r="55%">
                        <stop offset="0%" stop-color="rgba(106,58,26,0.35)"/>
                        <stop offset="100%" stop-color="rgba(0,0,0,0)"/>
                    </radialGradient>
                    <linearGradient id="alefGrad" x1="0%" y1="0%" x2="100%" y2="0%">
                        <stop offset="0%" stop-color="#ecc07a"/>
                        <stop offset="40%" stop-color="#ecc07a"/>
                        <stop offset="85%" stop-color="#ecc07a" stop-opacity="0"/>
                        <stop offset="100%" stop-color="#ecc07a" stop-opacity="0"/>
                    </linearGradient>
                    <linearGradient id="omegaGrad" x1="0%" y1="0%" x2="100%" y2="0%">
                        <stop offset="0%" stop-color="#c07238" stop-opacity="0"/>
                        <stop offset="15%" stop-color="#c07238" stop-opacity="0"/>
                        <stop offset="34%" stop-color="#c07238"/>
                        <stop offset="100%" stop-color="#c07238"/>
                    </linearGradient>
                </defs>
                <circle cx="100" cy="100" r="98" fill="url(#bgGrad)"/>
                <circle cx="100" cy="100" r="98" fill="url(#shineGrad)"/>
                <circle cx="100" cy="100" r="95" fill="none" stroke="#5e3018" stroke-width="1.4"/>
                <circle cx="100" cy="100" r="90" fill="none" stroke="#2c1508" stroke-width="0.6"/>
                <text x="100" y="100" text-anchor="middle" dominant-baseline="central"
                      font-size="120" font-family="Frank Ruhl Libre, serif" fill="url(#alefGrad)">א</text>
                <text x="100" y="100" text-anchor="middle" dominant-baseline="central"
                      font-size="120" font-family="GFS Didot, serif" fill="url(#omegaGrad)">Ω</text>
            </svg>
            <span class="site-logo-name">Alef–Omega</span>
        </a>

        {# Hamburger-knop — alleen zichtbaar op mobiel #}
        <button class="nav-hamburger"
                type="button"
                data-mobile-nav-target="hamburger"
                data-action="click->mobile-nav#toggle"
                aria-label="Menu openen"
                aria-expanded="false">
            <span class="hamburger-bar"></span>
            <span class="hamburger-bar"></span>
            <span class="hamburger-bar"></span>
        </button>

        {# Nav-links — op mobiel verborgen tot hamburger geopend is #}
        <div class="nav-links" data-mobile-nav-target="menu">

            <div class="nav-sep"></div>

            {# Bijbel-navigatie — kan per pagina worden overschreven #}
            {% block nav_bijbel %}
            <a href="{{ path('app_home') }}" class="nav-book-btn">Bijbel</a>
            {% endblock %}

            <div class="nav-sep"></div>
            <a href="{{ path('app_blog_index') }}" class="nav-book-btn">Blog</a>

            {# Editor-dropdown — alleen als gebruiker ten minste één editorrole heeft #}
            {% if is_granted('ROLE_LINKER') or is_granted('ROLE_EDIT_STRONG_TRNL') or is_granted('ROLE_BLOGGER') %}
            <div class="nav-sep"></div>
            <div class="nav-dropdown">
                <button class="nav-dropdown-btn" type="button">Editor ▾</button>
                <div class="nav-dropdown-menu">
                    {% if is_granted('ROLE_LINKER') %}
                    <a href="{{ path('app_linking_home') }}">Koppelen</a>
                    <a href="{{ path('app_linking_strongs_home') }}">Strong's koppelen</a>
                    <a href="{{ path('app_trans_linking_home') }}">Vertalingen koppelen</a>
                    <a href="{{ path('app_hist_align_home') }}">Historische alignment (SV1657)</a>
                    <a href="{{ path('app_linking_stats', {translation: 'SV'}) }}">Statistieken</a>
                    {% endif %}
                    {% if is_granted('ROLE_EDIT_STRONG_TRNL') %}
                    <a href="{{ path('app_strongs_translate_home') }}">Vertalen Strong's</a>
                    {% endif %}
                    {% if is_granted('ROLE_BLOGGER') %}
                    <a href="{{ path('app_blog_mine') }}">Mijn blogs</a>
                    <a href="{{ path('app_blog_new') }}">Nieuwe blog</a>
                    {% endif %}
                </div>
            </div>
            {% endif %}

            {# Admin-dropdown — alleen voor admins #}
            {% if is_granted('ROLE_ADMIN') %}
            <div class="nav-sep"></div>
            <div class="nav-dropdown">
                <button class="nav-dropdown-btn" type="button">Beheer ▾</button>
                <div class="nav-dropdown-menu">
                    <a href="{{ path('admin_users_index') }}">Gebruikers</a>
                </div>
            </div>
            {% endif %}

            {# Boek/hoofdstuk-knop — ingevuld door child templates #}
            {% block nav_center %}{% endblock %}

            {# Rechter groep #}
            <div class="nav-right">

                {# Donker/licht toggle #}
                <button class="nav-theme-btn"
                        type="button"
                        data-controller="theme"
                        data-action="click->theme#toggle"
                        aria-label="Thema wisselen">
                    <span data-theme-target="iconLight">☀</span>
                    <span data-theme-target="iconDark" style="display:none">🌙</span>
                </button>

                {# Extra nav-right items (bijv. Vertalingen-dropdown per pagina) #}
                {% block nav_right_extra %}{% endblock %}

                {# Gebruikermenu #}
                {% if app.user %}
                <div class="nav-user">
                    <button class="nav-user-btn" type="button">
                        {{ app.user.displayName }} ▾
                    </button>
                    <div class="nav-user-menu">
                        <a href="{{ path('app_profile') }}">Profiel</a>
                        <a href="{{ path('app_logout') }}" class="nav-logout">Uitloggen</a>
                    </div>
                </div>
                {% else %}
                <a href="{{ path('app_login') }}" class="nav-login-btn" data-turbo="false">Inloggen</a>
                {% endif %}

            </div>
        </div>{# /nav-links #}

    </nav>
</header>

<main class="site-main">
    {% block body %}{% endblock %}
</main>

<footer class="site-footer">
    <p>Statenvertaling (1637) · Codex Leningradensis · Textus Receptus Elzevir</p>
</footer>

{% block javascripts %}
    {% block importmap %}{{ importmap('app', {'nonce': csp_nonce(), 'data-turbo-permanent': 'data-turbo-permanent'}) }}{% endblock %}
{% endblock %}

</body>
</html>
