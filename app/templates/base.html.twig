<!DOCTYPE html>
<html lang="nl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {% block head %}{% endblock %}
    <title>{% block title %}Bijbel Vergelijking{% endblock %}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    {% block stylesheets %}
        {{ encore_entry_link_tags('app') }}
    {% endblock %}
</head>
<body>

<header class="site-header">
    <nav class="nav-inner">
        <a href="{{ path('app_home') }}" class="site-logo">
            <span class="logo-he">בראשית</span>
            <span class="logo-sep">·</span>
            <span class="logo-title">(H)SV Translators Tags</span>
            <span class="logo-sep">·</span>
            <span class="logo-gk">Ἐν ἀρχῇ</span>
        </a>
        <div class="nav-links">
            <a href="{{ path('app_home') }}">Bijbelboeken</a>
            <a href="{{ path('app_linking_home') }}">Koppelen</a>
            <a href="{{ path('app_linking_strongs_home') }}">Koppelen Strong's</a>
            {% if is_granted('ROLE_LINKER') %}
            <a href="{{ path('app_trans_linking_home') }}">Vertalingen koppelen</a>
            {% endif %}
            {% if is_granted('ROLE_EDIT_STRONG_TRNL') %}
            <a href="{{ path('app_strongs_translate_home') }}">Vertalen Strong's</a>
            {% endif %}
            {% if app.user %}
            <div class="nav-user">
                <button class="nav-user-btn" type="button">
                    {{ app.user.displayName }} ▾
                </button>
                <div class="nav-user-menu">
                    <a href="{{ path('app_profile') }}">Profiel</a>
                    <a href="{{ path('app_logout') }}" class="nav-logout">Uitloggen</a>
                </div>
            </div>
            {% endif %}
        </div>
    </nav>
</header>

<main class="site-main">
    {% block body %}{% endblock %}
</main>

<footer class="site-footer">
    <p>Statenvertaling (1637) · Codex Leningradensis · Textus Receptus Elzevir</p>
</footer>

{% block javascripts %}
            {% block importmap %}{{ importmap('app', {'data-turbo-permanent': 'data-turbo-permanent'}) }}{% endblock %}
    {{ encore_entry_script_tags('app') }}
{% endblock %}

</body>
</html>
