{% extends 'base.html.twig' %}

{% block title %}Mijn blogs – Alef–Omega{% endblock %}

{% block body %}
<div class="container container--wide">

    <div class="admin-page-header">
        <h1>{{ is_granted('ROLE_ADMIN') ? 'Alle blogs' : 'Mijn blogs' }}</h1>
        <a href="{{ path('app_blog_new') }}" class="btn-primary">+ Nieuwe blog</a>
    </div>

    {% for label, messages in app.flashes %}
        {% for message in messages %}
        <div class="alert alert-{{ label }}" role="alert">{{ message }}</div>
        {% endfor %}
    {% endfor %}

    {% if blogs is empty %}
    <p class="text-muted">Nog geen blogs.</p>
    {% else %}
    <div class="table-scroll blog-mine-table-wrap">
    <table class="admin-table">
        <thead>
            <tr>
                <th>Titel</th>
                <th>Auteur</th>
                <th>Status</th>
                <th>Zichtbaarheid</th>
                <th>Laatst bewerkt</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        {% for blog in blogs %}
            <tr>
                <td>{{ blog.title }}</td>
                <td>{{ blog.author.displayName }}</td>
                <td><span class="badge-status badge-status--{{ blog.status }}">{{ blog.status == 'published' ? 'Gepubliceerd' : 'Concept' }}</span></td>
                <td>{{ blog.visibility == 'logged_in' ? 'Alleen ingelogd' : 'Publiek' }}</td>
                <td>{{ blog.updatedAt|date('d-m-Y H:i') }}</td>
                <td>
                    <a href="{{ path('app_blog_edit', {slug: blog.slug}) }}">Bewerken</a>
                    <a href="{{ path('app_blog_show', {slug: blog.slug}) }}">Bekijken</a>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    </div>

    {# Mobiel: dezelfde data als kaarten i.p.v. een scrollende tabel -- zie
       .blog-mine-table-wrap / .blog-mine-cards in app.css voor de media
       query die tussen de twee schakelt. #}
    <div class="blog-mine-cards">
        {% for blog in blogs %}
        <div class="blog-mine-card">
            <div class="blog-mine-card-head">
                <span class="blog-mine-card-title">{{ blog.title }}</span>
                <span class="badge-status badge-status--{{ blog.status }}">{{ blog.status == 'published' ? 'Gepubliceerd' : 'Concept' }}</span>
            </div>
            <div class="blog-mine-card-meta">
                {{ blog.author.displayName }} · {{ blog.visibility == 'logged_in' ? 'Alleen ingelogd' : 'Publiek' }} · {{ blog.updatedAt|date('d-m-Y H:i') }}
            </div>
            <div class="blog-mine-card-actions">
                <a class="btn btn-sm btn-primary" href="{{ path('app_blog_edit', {slug: blog.slug}) }}">Bewerken</a>
                <a class="btn btn-sm" href="{{ path('app_blog_show', {slug: blog.slug}) }}">Bekijken</a>
            </div>
        </div>
        {% endfor %}
    </div>
    {% endif %}

</div>
{% endblock %}
