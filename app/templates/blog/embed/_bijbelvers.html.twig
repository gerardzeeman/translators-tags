{% set is_highlighting = highlight_links and not alleen_vertaling %}
{% set is_multi = translations|length > 1 %}
<div class="embed-bible embed-layout-{{ layout }}"
     {% if is_highlighting %}data-controller="embed-highlight"{% endif %}>
    {% for v in verses %}
    <div class="embed-verse-block">
        <div class="embed-verse-header">
            <span class="embed-verse-ref">{{ v.book.nameNl }} {{ v.chapter }}:{{ v.verse }}</span>
            {% if (toon_vertaling or alleen_vertaling) and not is_multi and translations[0] is defined %}
            <span class="embed-translation-code">{{ translations[0].abbreviation }}</span>
            {% endif %}
        </div>
        <div class="embed-verse-content">

            {% if not alleen_vertaling %}
            <div class="embed-source{% if v.testament == 'OT' %} dir-rtl{% endif %}">
                {% for word in v.source_words %}
                <span class="embed-source-word"
                      {% if is_highlighting %}
                      data-embed-highlight-target="sourceWord"
                      data-link-ids="{{ word.dutch_links|map(l => l.tw_id)|join(',') }}"
                      data-action="mouseenter->embed-highlight#highlightSource mouseleave->embed-highlight#unhighlightSource"
                      {% endif %}
                      title="{{ woord_info == 'morfologie' ? word.morph_description : word.transliteration }}">{{- word.word_text -}}</span>{{- ' ' -}}
                {% endfor %}
            </div>
            {% endif %}

            {% if toon_vertaling or alleen_vertaling %}
            <div class="embed-translations">
                {% for t in translations %}
                <div class="embed-translation">
                    {% if is_multi %}
                    <span class="embed-translation-label">{{ t.abbreviation }}</span>
                    {% endif %}
                    {% for word in v.dutch_verses[t.code] %}
                    <span class="embed-dutch-word"
                          {% if is_highlighting %}
                          data-embed-highlight-target="dutchWord"
                          data-word-id="{{ word.word_id }}"
                          data-action="mouseenter->embed-highlight#highlightDutch mouseleave->embed-highlight#unhighlightDutch"
                          {% endif %}>{{- word.word_text -}}</span>{{- word.punct_after -}}{%- if not loop.last %} {% endif -%}
                    {% else %}
                    <em class="embed-no-translation">Geen vertaling gevonden.</em>
                    {% endfor %}
                </div>
                {% endfor %}
            </div>
            {% endif %}

        </div>
    </div>
    {% endfor %}
</div>
