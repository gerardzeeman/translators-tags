{% macro note_marker(kind, glyph, note, verse_href) %}<span class="institutio-note institutio-note-{{ kind }}" tabindex="0"><sup class="institutio-note-glyph">{% if verse_href %}<a href="{{ verse_href }}" data-turbo-frame="institutio-verse-panel" title="Bekijk Bijbeltekst">{{ glyph }}</a>{% else %}{{ glyph }}{% endif %}</sup><span class="institutio-note-popup"><span class="institutio-note-popup-kind">{{ kind == 'variant' ? 'Variant lezing' : 'Verwijzing' }}</span>{{ note }}</span></span>{% endmacro %}
{# A Latin word's popup: lemma (library number) with its gloss below. A
   Hebrew/Greek word Calvin quotes (strongs = {id, transliteration, meaning},
   see ConfessionRepository::attachTokens) the same way: transliteration
   (Strong's number), first meaning below. #}
{% macro word_hover(content, lemma, gloss, differs = false, number = null, strongs = null) %}<span class="institutio-word{{ differs ? ' institutio-word-hc-diff' : '' }}" tabindex="0">{{ content }}<span class="institutio-word-popup">{% if strongs %}<span class="institutio-word-lemma">{{ strongs.transliteration ?? content }} (<a href="{{ path('app_strongs', {number: strongs.id}) }}" class="institutio-word-lemma-link" data-turbo-frame="strongs-panel" data-panel-title="Lexicon">{{ strongs.id }}</a>)</span>{% if strongs.meaning %}<span class="institutio-word-gloss">{{ strongs.meaning }}</span>{% endif %}{% else %}<span class="institutio-word-lemma">{{ lemma ?? content }}{% if number and is_granted('ROLE_VIEWER_LEMMAS') %} (<a href="{{ path('app_lemma_library_detail', {number: 'l' ~ number}) }}" class="institutio-word-lemma-link">L{{ number }}</a>){% endif %}</span>{% if gloss %}<span class="institutio-word-gloss">{{ gloss }}</span>{% endif %}{% endif %}</span></span>{% endmacro %}
