{% extends 'base.html.twig' %}
{% import 'confession/_macros.html.twig' as c %}
{% import 'commentary/_macros.html.twig' as cm %}
{% block title %}{{ meta.title }} · Argumentum – Bijbel Vergelijking{% endblock %}

{% block nav_center %}{% endblock %}

{% block body %}
<div class="page-institutio page-commentary" data-controller="verse-panel strongs-panel">

    <nav class="chapter-nav" aria-label="Commentaar navigatie">
        <a href="{{ path('app_commentary_toc', {boek: boek}) }}" class="chapter-nav-book">{{ meta.title }}</a>
        <span class="chapter-nav-sep">›</span>
        <span class="chapter-nav-current">Argumentum</span>
        <div class="chapter-nav-arrows">
            <a href="{{ path('app_commentary_chapter', {boek: boek, chapter: 1}) }}" class="nav-btn" title="Hoofdstuk 1">›</a>
        </div>
    </nav>

    <div class="institutio-heading institutio-heading-solo">Argumentum</div>
    <p class="commentary-part-hint">Calvijns inleiding op het boek. De Nederlandse alinea's zijn bij benadering verdeeld: Latijn en Nederlands zijn anders in alinea's opgedeeld.</p>

    {% include 'commentary/_spelling_bar.html.twig' %}
    <div class="institutio-sections">
        {% for s in segments %}
        <div class="institutio-section" id="arg-{{ s.section }}">
            <span class="institutio-section-num">{{ s.section }}</span>
            <div class="institutio-sentence-group">
                <div class="institutio-sentence-row commentary-row-3">
                    <div class="institutio-sentence-la">{{ c.la_parts(s.parts) }}</div>
                    <div class="institutio-sentence-nl">
                        {{ cm.dutch(s.nl_paras) }}
                    </div>
                    <div class="institutio-sentence-nl commentary-nl-modern">
                        <span class="institutio-layer-label">Los, moderne spelling</span>
                        {{ cm.dutch(s.nl_modern) }}
                    </div>
                </div>
            </div>
        </div>
        {% endfor %}
    </div>

    {% include 'confession/_verse_sidebar.html.twig' %}
    {% include 'commentary/_strongs_sidebar.html.twig' %}

</div>
{% endblock %}
