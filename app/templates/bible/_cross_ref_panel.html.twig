<turbo-frame id="strongs-panel">
<div class="cross-ref-panel">
    <span class="cross-ref-panel-trans">{{ translation.abbreviation }}</span>
    {% for v in verses %}
    <div class="cross-ref-panel-item{% if v.is_active %} is-active{% endif %}">
        <h3 class="cross-ref-panel-ref">{{ v.book.nameNl }} {{ v.chapter }}:{{ v.verse }}</h3>
        {% if v.text %}
        <p class="cross-ref-panel-text">{{ v.text }}</p>
        {% else %}
        <p class="strongs-note">Vers niet gevonden in {{ translation.name }}.</p>
        {% endif %}
    </div>
    {% else %}
    <p class="strongs-note">Geen verwijzingen gevonden.</p>
    {% endfor %}
</div>
</turbo-frame>
