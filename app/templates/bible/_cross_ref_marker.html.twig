{% if markers is defined %}
{% for m in markers %}
<span class="cross-ref-marker" tabindex="0">
    <sup class="cross-ref-letter">{{ m.letter }}</sup>
    <span class="cross-ref-popup">
        {% for t in m.targets %}
        <a href="{{ path('app_cross_ref_panel', {usfm: t.target_usfm, chapter: t.target_chapter, verse: t.target_verse, translation: translation_code}) }}"
           data-turbo-frame="strongs-panel"
           data-panel-title="Tekstverwijzing">{{ t.label }}</a>
        {% endfor %}
    </span>
</span>
{% endfor %}
{% endif %}
