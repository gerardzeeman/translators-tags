{% extends 'base.html.twig' %}

{% block title %}{{ book.nameNl }} {{ chapter }}:{{ verse }} – Bijbel Vergelijking{% endblock %}

{% block body %}
<div class="page-verse" data-controller="verse-compare">

    {# Breadcrumb + navigation #}
    <nav class="verse-nav" aria-label="Vers navigatie">
        <a href="{{ path('app_book', {usfm: book.usfmCode}) }}">{{ book.nameNl }}</a>
        <span>›</span>
        <a href="{{ path('app_chapter', {usfm: book.usfmCode, chapter: chapter}) }}">Hoofdstuk {{ chapter }}</a>
        <span>›</span>
        <strong>Vers {{ verse }}</strong>

        <div class="nav-arrows">
            {% if nav.prev %}
            <a href="{{ path('app_verse', nav.prev) }}" class="nav-btn" title="Vorig vers" data-turbo-frame="verse-frame">‹</a>
            {% endif %}
            {% if nav.next %}
            <a href="{{ path('app_verse', nav.next) }}" class="nav-btn" title="Volgend vers" data-turbo-frame="verse-frame">›</a>
            {% endif %}
        </div>
    </nav>

    <turbo-frame id="verse-frame">
        {% include 'bible/verse_frame.html.twig' %}
    </turbo-frame>

</div>
{% endblock %}
