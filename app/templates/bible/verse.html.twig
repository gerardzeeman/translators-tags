{% extends 'base.html.twig' %}

{% block title %}{{ book.nameNl }} {{ chapter }}:{{ verse }} – Bijbel Vergelijking{% endblock %}

{% block body %}
<div class="page-verse" data-controller="verse-compare">

    {# Static part of breadcrumb — book never changes during in-page navigation #}
    <nav class="verse-nav-static" aria-label="Boek navigatie">
        <a href="{{ path('app_book', {usfm: book.usfmCode}) }}">{{ book.nameNl }}</a>
    </nav>

    {# Everything from chapter/verse onward lives inside the frame so it updates
       correctly when the prev/next arrows are clicked. #}
    <turbo-frame id="verse-frame">
        {% include 'bible/verse_frame.html.twig' %}
    </turbo-frame>

</div>
{% endblock %}
