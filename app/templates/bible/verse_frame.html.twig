<turbo-frame id="verse-frame">

{# Nav lives inside the frame so chapter/verse breadcrumb and arrows update on every navigation #}
<nav class="verse-nav" aria-label="Vers navigatie">
    <span>›</span>
    <a href="{{ path('app_chapter', {usfm: book.usfmCode, chapter: chapter}) }}">Hoofdstuk {{ chapter }}</a>
    <span>›</span>
    <strong>Vers {{ verse }}</strong>

    <div class="nav-arrows">
        {% if nav.prev %}
        <a href="{{ path('app_verse', nav.prev) }}"
           class="nav-btn" title="Vorig vers"
           data-turbo-action="advance">‹</a>
        {% endif %}
        {% if nav.next %}
        <a href="{{ path('app_verse', nav.next) }}"
           class="nav-btn" title="Volgend vers"
           data-turbo-action="advance">›</a>
        {% endif %}
    </div>
</nav>

<div class="verse-compare-grid" data-active-translation="{{ translation.code }}">
<div class="compare-col compare-col-left">

    {# ── Source language panel (left, top) ───────────────────────────────── #}
    <section class="panel panel-source"
             aria-label="{{ passage.testament == 'OT' ? 'Hebreeuws' : 'Grieks' }}">

        <h2 class="panel-heading">
            {% if passage.testament == 'OT' %}
                <span class="lang-badge lang-he">עִבְרִית</span> Hebreeuws
            {% else %}
                <span class="lang-badge lang-gk">Ἑλληνικά</span> Grieks
            {% endif %}

            {# Translation indicator switcher — pure JS, no page reload.
               HSV button only shown to users with ROLE_VIEWER_HSV. #}
            {% if is_granted('ROLE_VIEWER_HSV') %}
            <div class="translation-indicator-toggle">
                <span class="toggle-label">Indicatoren:</span>
                {% for t in translations %}
                <button class="trans-btn{% if t.id == translation.id %} trans-btn-active{% endif %}"
                        data-action="click->verse-compare#switchTranslation"
                        data-translation="{{ t.code }}"
                        type="button">
                    {{ t.code }}
                </button>
                {% endfor %}
            </div>
            {% endif %}
        </h2>

        <div class="source-words {% if passage.testament == 'OT' %}dir-rtl{% endif %}">
            {% for word in passage.source_words %}
            <div class="source-word"
                 data-source-id="{{ word.id }}"
                 data-lang="{{ passage.testament == 'OT' ? 'HE' : 'GR' }}"
                 data-strongs="{{ word.strongs }}"
                 data-linked-sv-ids="{{ word.links_sv|map(l => l.tw_id)|join(',') }}"
                 data-linked-hsv-ids="{{ word.links_hsv|map(l => l.tw_id)|join(',') }}"
                 data-controller="source-word">

                <span class="word-text">{{ word.word_text }}</span>

                {% if word.transliteration %}
                <span class="word-translit">{{ word.transliteration }}</span>
                {% endif %}

                {% if word.strongs %}
                <a href="{{ path('app_strongs', {number: word.strongs}) }}"
                   class="word-strongs"
                   data-turbo-frame="strongs-panel">{{ word.strongs }}</a>
                {% endif %}

                {% if word.morph_description %}
                <span class="word-morph" title="{{ word.morph_description }}">
                    {{ passage.testament == 'OT' ? word.morph_code : word.parse_code }}
                </span>
                {% endif %}

                {# Link indicators — one set per translation, CSS toggles visibility #}
                <div class="link-indicators sv-indicators">
                    {% if word.links_sv|length > 0 %}
                        {% for link in word.links_sv %}
                        {% set score = link.score|default(0) %}
                        <span class="link-dot method-{{ link.method }}"
                              title="{{ link.word_text }} ({{ link.method }}: {{ (score * 100)|round }}%)">
                            {{ link.word_text }}
                        </span>
                        {% endfor %}
                    {% else %}
                        <span class="no-link-badge" title="Geen koppeling SV">—</span>
                    {% endif %}
                </div>
                <div class="link-indicators hsv-indicators">
                    {% if word.links_hsv|length > 0 %}
                        {% for link in word.links_hsv %}
                        {% set score = link.score|default(0) %}
                        {% set isPropagated = link.method in ['auto_source_pivot','auto_sequence','auto_positional'] %}
                        <span class="link-dot method-{{ link.method }}{% if isPropagated %} link-dot-propagated{% endif %}"
                              title="{{ link.word_text }} ({{ link.method }}: {{ score is not null ? (score * 100)|round ~ '%' : '✓' }})">
                            {{ link.word_text }}
                        </span>
                        {% endfor %}
                    {% else %}
                        <span class="no-link-badge" title="Geen koppeling HSV">—</span>
                    {% endif %}
                </div>

            </div>
            {% endfor %}
        </div>
    </section>

    {# ── Strong's detail panel (left, bottom) ────────────────────────────── #}
    <section class="panel panel-strongs">
        <h2 class="panel-heading">Strong's Details</h2>
        <turbo-frame id="strongs-panel">
            <p class="strongs-placeholder">Klik op een Strong's nummer om details te zien.</p>
        </turbo-frame>
    </section>

</div>{# /compare-col-left #}
<div class="compare-col compare-col-right">

    {# ── SV translation panel (right, top) ───────────────────────────────── #}
    <section class="panel panel-sv" aria-label="Statenvertaling">

        <h2 class="panel-heading">
            <span class="lang-badge lang-nl">NL</span> Statenvertaling
        </h2>

        <div class="dutch-verse">
            {% for word in passage.dutch_verse_sv %}
            <span class="dutch-word"
                  data-tw-id="{{ word.word_id }}"
                  data-method="{{ word.best_method ?? 'none' }}"
                  data-score="{{ word.best_score ?? 0 }}"
                  data-controller="dutch-word">
                {{- word.word_text -}}
            </span>{{- word.punct_after ?? '' -}}{%- if not loop.last %} {% endif -%}
            {% else %}
            <em class="no-verse">Vers niet gevonden in de Statenvertaling.</em>
            {% endfor %}
        </div>

        <div class="confidence-legend">
            <span class="legend-item"><span class="dot method-manual"></span> Handmatig</span>
            <span class="legend-item"><span class="dot method-manual_hint"></span> Hint</span>
            <span class="legend-item"><span class="dot method-proper_noun"></span> Eigennaam</span>
            <span class="legend-item"><span class="dot method-positional"></span> Positioneel</span>
            <span class="legend-item"><span class="dot method-none"></span> Geen koppeling</span>
        </div>

    </section>

    {# ── HSV translation panel (right, bottom) — ROLE_VIEWER_HSV only ─────────── #}
    {% if is_granted('ROLE_VIEWER_HSV') %}
    <section class="panel panel-hsv" aria-label="Herziene Statenvertaling">

        <h2 class="panel-heading">
            <span class="lang-badge lang-nl">NL</span> Herziene Statenvertaling
        </h2>

        <div class="dutch-verse">
            {% for word in passage.dutch_verse_hsv %}
            <span class="dutch-word{% if word.is_filler %} word-filler{% endif %}"
                  data-tw-id="{{ word.word_id }}"
                  data-method="{{ word.best_method ?? 'none' }}"
                  data-score="{{ word.best_score ?? 0 }}"
                  data-filler="{{ word.is_filler ? '1' : '0' }}"
                  data-controller="dutch-word">
                {{- word.word_text -}}
            </span>{{- word.punct_after ?? '' -}}{%- if not loop.last %} {% endif -%}
            {% else %}
            <em class="no-verse">Vers niet gevonden in de Herziene Statenvertaling.</em>
            {% endfor %}
        </div>

        <div class="confidence-legend">
            <span class="legend-item"><span class="dot method-manual"></span> Handmatig</span>
            <span class="legend-item"><span class="dot method-manual_hint"></span> Hint</span>
            <span class="legend-item"><span class="dot method-proper_noun"></span> Eigennaam</span>
            <span class="legend-item"><span class="dot method-positional"></span> Positioneel</span>
            <span class="legend-item"><span class="dot method-auto_source_pivot"></span> Afgeleid (SV-koppeling)</span>
            <span class="legend-item"><span class="dot method-none"></span> Geen koppeling</span>
        </div>

    </section>
    {% endif %}{# ROLE_VIEWER_HSV #}

</div>{# /compare-col-right #}
</div>{# /verse-compare-grid #}
</turbo-frame>
