###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=change_me_generate_with_openssl_rand_hex_32
###< symfony/framework-bundle ###

###> app ###
# Stel echte waarden in via .env.local (nooit committen)
REMEMBER_ME_SECRET=change_me_generate_with_openssl_rand_hex_32
# Google Analytics 4 measurement ID (bijv. G-XXXXXXXXXX). Leeg = analytics uitgeschakeld.
GOOGLE_ANALYTICS_ID=
# Web Push (docs/push-notifications-plan.md) -- genereer met:
#   docker compose exec app php bin/console app:push:generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Bearer-token voor de scheduled-task-webhook. Genereer met: openssl rand -hex 32
NEWS_DIGEST_WEBHOOK_TOKEN=
# Kill switch, los van tokenrotatie (zie plan §3.1)
NEWS_DIGEST_PUSH_ENABLED=true
###< app ###

###> symfony/routing ###
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
DATABASE_URL="postgresql://app:!ChangeMe!@127.0.0.1:5432/app?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/lock ###
LOCK_DSN=flock
###< symfony/lock ###
