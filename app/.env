###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=change_me_generate_with_openssl_rand_hex_32
###< symfony/framework-bundle ###

###> app ###
# Stel echte waarden in via .env.local (nooit committen)
REMEMBER_ME_SECRET=change_me_generate_with_openssl_rand_hex_32
# Google Analytics 4 measurement ID (bijv. G-XXXXXXXXXX). Leeg = analytics uitgeschakeld.
GOOGLE_ANALYTICS_ID=
###< app ###

###> symfony/routing ###
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
DATABASE_URL="postgresql://app:!ChangeMe!@127.0.0.1:5432/app?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/lock ###
LOCK_DSN=flock
###< symfony/lock ###
